# WayFare AI学习助手 - 环境变量配置
# 复制此文件为 .env 并根据需要修改配置

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wayfare_db
DB_USER=wayfare_user
DB_PASSWORD=wayfare_password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800  # 50MB (字节)

# 服务端口配置
GO_BACKEND_PORT=8080
PYTHON_AI_PORT=8001
CPP_SANDBOX_PORT=8002
FRONTEND_PORT=3000

# OpenAI API配置 (可选)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs

# 安全配置
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=*

# 开发环境配置
NODE_ENV=development
API_TIMEOUT=30000
RETRY_ATTEMPTS=3

# 生产环境配置 (取消注释并修改)
# NODE_ENV=production
# CORS_ORIGIN=https://yourdomain.com
# LOG_LEVEL=WARN