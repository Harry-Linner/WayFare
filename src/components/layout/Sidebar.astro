<div class="relative flex h-full">
  <nav class="z-30 flex w-[72px] flex-col items-center justify-between border-r border-slate-100 bg-white/88 py-6 backdrop-blur-sm">
    <div class="flex flex-col items-center gap-4">
      <div class="flex h-10 w-10 items-center justify-center rounded-md border border-slate-100 bg-brand-surface/40 text-[11px] font-medium uppercase tracking-[0.18em] text-slate-500">
        WF
      </div>

      <button class="nav-icon-btn group relative" data-drawer="files" title="文件与项目">
        <div class="flex h-10 w-10 items-center justify-center rounded-md border border-slate-100 bg-white text-slate-500 transition hover:border-brand-blue/40 hover:text-slate-700">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 7.5h6l1.5 1.5h9v7.5a1.5 1.5 0 0 1-1.5 1.5h-13.5a1.5 1.5 0 0 1-1.5-1.5z" />
          </svg>
        </div>
        <div class="indicator absolute -right-[13px] top-1/2 hidden h-5 w-px -translate-y-1/2 bg-brand-blue/80"></div>
      </button>

      <button class="nav-icon-btn group relative" data-drawer="config" title="偏好设置">
        <div class="flex h-10 w-10 items-center justify-center rounded-md border border-slate-100 bg-white text-slate-500 transition hover:border-brand-blue/40 hover:text-slate-700">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9m-9 6h9m-9 6h9M4.5 6h.008v.008H4.5zm0 6h.008v.008H4.5zm0 6h.008v.008H4.5z" />
          </svg>
        </div>
        <div class="indicator absolute -right-[13px] top-1/2 hidden h-5 w-px -translate-y-1/2 bg-brand-blue/80"></div>
      </button>
    </div>

    <div class="flex h-10 w-10 items-center justify-center rounded-md border border-slate-100 bg-brand-sand/35 text-[11px] font-medium uppercase tracking-[0.18em] text-slate-500">
      02
    </div>
  </nav>

  <aside id="side-drawer" class="absolute left-[72px] top-0 z-20 h-full w-0 overflow-hidden border-r border-slate-100 bg-[#fcfcf8]/96 transition-all duration-300">
    <div class="h-full w-72 px-5 py-5">
      <div id="drawer-content-files" class="drawer-section hidden h-full flex-col">
        <div class="mb-6 flex items-center justify-between">
          <div>
            <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Files</p>
            <h3 class="mt-1 text-base font-medium tracking-tight text-slate-800">知识库目录</h3>
          </div>
          <button id="btn-new-project" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-100 bg-white text-slate-500 transition hover:border-brand-blue/40 hover:text-slate-700" title="新建项目">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
            </svg>
          </button>
        </div>

        <div class="flex-1 space-y-6 overflow-y-auto">
          <section>
            <p class="mb-2 text-[11px] uppercase tracking-[0.22em] text-slate-400">Folder Tree</p>
            <div id="folder-tree" class="space-y-2 text-sm">
              <div class="folder-item expanded" data-path="/">
                <div class="folder-header flex cursor-pointer items-center gap-2 rounded-md border border-slate-100 bg-white px-3 py-2 text-slate-600 transition hover:border-brand-blue/30">
                  <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 7.5h6l1.5 1.5h9v7.5a1.5 1.5 0 0 1-1.5 1.5h-13.5a1.5 1.5 0 0 1-1.5-1.5z" />
                  </svg>
                  <span class="flex-1 tracking-tight">知识库根目录</span>
                  <button class="add-folder-btn flex h-6 w-6 items-center justify-center rounded-md border border-transparent text-slate-400 transition hover:border-slate-100 hover:text-slate-600" title="新建文件夹">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
                    </svg>
                  </button>
                </div>
                <div class="folder-children ml-4 mt-2 space-y-2">
                  <div class="folder-item" data-path="/课程笔记">
                    <div class="folder-header flex cursor-pointer items-center gap-2 rounded-md px-3 py-2 text-slate-500 transition hover:bg-white">
                      <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 7.5h6l1.5 1.5h9v7.5a1.5 1.5 0 0 1-1.5 1.5h-13.5a1.5 1.5 0 0 1-1.5-1.5z" />
                      </svg>
                      <span class="tracking-tight">课程笔记</span>
                    </div>
                    <div class="folder-children hidden ml-4 mt-1 space-y-1"></div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section>
            <p class="mb-2 text-[11px] uppercase tracking-[0.22em] text-slate-400">Current Files</p>
            <ul id="current-project-files" class="space-y-2 text-sm">
              <li class="file-item flex items-center gap-3 rounded-md border border-slate-100 bg-white px-3 py-2 tracking-tight text-slate-600" data-path="/数据结构/第三章.pdf">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 4.5h6l4.5 4.5V19.5H7.5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5v4.5H18" />
                </svg>
                <span class="flex-1">数据结构_第三章.pdf</span>
                <button class="file-action-btn flex h-6 w-6 items-center justify-center rounded-md text-slate-400 transition hover:bg-slate-50 hover:text-slate-600" title="更多操作">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 5.25a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Zm0 6a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Zm0 6a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Z" />
                  </svg>
                </button>
              </li>
              <li class="file-item flex items-center gap-3 rounded-md border border-slate-100 bg-white px-3 py-2 tracking-tight text-slate-600" data-path="/操作系统/导论.pdf">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 4.5h6l4.5 4.5V19.5H7.5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5v4.5H18" />
                </svg>
                <span class="flex-1">操作系统导论.pdf</span>
                <button class="file-action-btn flex h-6 w-6 items-center justify-center rounded-md text-slate-400 transition hover:bg-slate-50 hover:text-slate-600" title="更多操作">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 5.25a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Zm0 6a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Zm0 6a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5Z" />
                  </svg>
                </button>
              </li>
            </ul>
          </section>

          <section id="config-files-section" class="hidden">
            <p class="mb-2 text-[11px] uppercase tracking-[0.22em] text-slate-400">Config Files</p>
            <ul class="space-y-2 text-sm">
              <li class="config-file-item rounded-md border border-slate-100 bg-white px-3 py-2 font-mono text-[12px] tracking-tight text-slate-500" data-path="/.kb_config.json">.kb_config.json</li>
              <li class="config-file-item rounded-md border border-slate-100 bg-white px-3 py-2 font-mono text-[12px] tracking-tight text-slate-500" data-path="/.learning_profile.json">.learning_profile.json</li>
            </ul>
          </section>
        </div>

        <button id="toggle-config" class="mt-5 rounded-md border border-slate-100 bg-white px-3 py-2 text-xs tracking-tight text-slate-500 transition hover:border-brand-blue/40 hover:bg-brand-surface/25 hover:text-slate-700">
          显示配置文件
        </button>
      </div>

      <div id="drawer-content-config" class="drawer-section hidden">
        <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Preferences</p>
        <h3 class="mt-1 text-base font-medium tracking-tight text-slate-800">阅读与偏好</h3>

        <div class="mt-6 space-y-6">
          <div>
            <p class="mb-3 text-sm font-medium tracking-tight text-slate-700">AI 响应密度</p>
            <div class="grid grid-cols-2 gap-2">
              <button class="rounded-md border border-brand-blue/40 bg-brand-surface/30 px-3 py-2 text-sm tracking-tight text-slate-700">简洁模式</button>
              <button class="rounded-md border border-slate-100 bg-white px-3 py-2 text-sm tracking-tight text-slate-500">展开模式</button>
            </div>
          </div>

          <div class="rounded-md border border-slate-100 bg-brand-surface/20 px-4 py-4">
            <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Profile</p>
            <p class="mt-2 text-sm leading-6 tracking-tight text-slate-600">当前偏好：考研 408 / 解释优先 / 轻量提示</p>
          </div>
        </div>
      </div>
    </div>
  </aside>
</div>

<script>
  const drawer = document.getElementById('side-drawer');
  const sections = document.querySelectorAll('.drawer-section');
  const buttons = document.querySelectorAll('[data-drawer]');
  const configSection = document.getElementById('config-files-section');
  const toggleConfigBtn = document.getElementById('toggle-config');
  const btnNewProject = document.getElementById('btn-new-project');

  let activeDrawer = null;
  let showConfig = false;

  function closeDrawer() {
    drawer.style.width = '0';
    activeDrawer = null;
    document.querySelectorAll('.indicator').forEach((i) => i.classList.add('hidden'));
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-drawer');
      const indicator = btn.querySelector('.indicator');

      if (activeDrawer === target) {
        closeDrawer();
        return;
      }

      sections.forEach((section) => section.classList.add('hidden'));
      document.getElementById(`drawer-content-${target}`)?.classList.remove('hidden');
      document.getElementById(`drawer-content-${target}`)?.classList.add('flex');

      drawer.style.width = '288px';
      activeDrawer = target;

      document.querySelectorAll('.indicator').forEach((i) => i.classList.add('hidden'));
      indicator?.classList.remove('hidden');
    });
  });

  toggleConfigBtn?.addEventListener('click', () => {
    showConfig = !showConfig;
    configSection?.classList.toggle('hidden', !showConfig);
    toggleConfigBtn.textContent = showConfig ? '隐藏配置文件' : '显示配置文件';
  });

  btnNewProject?.addEventListener('click', () => {
    alert('新建项目功能开发中...');
  });

  document.querySelectorAll('.folder-header').forEach((header) => {
    header.addEventListener('click', (e) => {
      if (e.target.closest('button')) return;
      const folderItem = header.closest('.folder-item');
      const children = folderItem?.querySelector('.folder-children');
      children?.classList.toggle('hidden');
    });
  });

  document.querySelectorAll('.add-folder-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const folderItem = btn.closest('.folder-item');
      const children = folderItem?.querySelector('.folder-children');
      if (!children) return;

      const name = prompt('输入新文件夹名称');
      if (!name) return;

      const node = document.createElement('div');
      node.className = 'folder-item';
      node.innerHTML = `
        <div class="folder-header flex cursor-pointer items-center gap-2 rounded-md px-3 py-2 text-slate-500 transition hover:bg-white">
          <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 7.5h6l1.5 1.5h9v7.5a1.5 1.5 0 0 1-1.5 1.5h-13.5a1.5 1.5 0 0 1-1.5-1.5z" />
          </svg>
          <span class="tracking-tight">${name}</span>
        </div>
        <div class="folder-children hidden ml-4 mt-1 space-y-1"></div>
      `;
      children.appendChild(node);
    });
  });

  document.querySelectorAll('.file-action-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      alert('更多文件操作功能开发中...');
    });
  });
</script>
