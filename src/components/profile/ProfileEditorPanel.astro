---
export interface Props {
  scope: 'global' | 'knowledge-base';
  knowledgeBaseId?: string;
  title: string;
  description: string;
  onboardingHref?: string;
}

const { scope, knowledgeBaseId = '', title, description, onboardingHref = '' } = Astro.props;
---

<section
  data-profile-editor
  data-scope={scope}
  data-knowledge-base-id={knowledgeBaseId}
  data-onboarding-href={onboardingHref}
  class="rounded-lg border border-slate-100 bg-white/80 px-5 py-5"
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">
        {scope === 'global' ? 'Global Prompt Anchor' : 'Knowledge Base Prompt Anchor'}
      </p>
      <h3 class="mt-1 text-lg font-medium tracking-tight text-slate-800">{title}</h3>
      <p class="mt-2 text-sm leading-7 text-slate-500">{description}</p>
    </div>
    <div class="flex flex-wrap items-center gap-2 sm:justify-end">
      <button
        type="button"
        data-profile-refresh
        class="inline-flex items-center justify-center rounded-md border border-slate-100 bg-white px-3 py-2 text-sm tracking-tight text-slate-500 transition hover:border-slate-200 hover:bg-slate-50 hover:text-slate-700"
      >
        刷新
      </button>
      <button
        type="button"
        data-profile-toggle
        class="inline-flex items-center justify-center rounded-md border border-slate-100 bg-brand-surface/45 px-3 py-2 text-sm tracking-tight text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface"
      >
        编辑画像
      </button>
    </div>
  </div>

  <div class="mt-4 rounded-md border border-slate-100 bg-brand-surface/18 px-4 py-4">
    <p class="text-[11px] uppercase tracking-[0.18em] text-slate-400">Preview</p>
    <div data-profile-preview class="mt-2 text-sm leading-7 text-slate-600">
      正在加载画像内容...
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <p data-profile-meta class="text-xs tracking-tight text-slate-400"></p>
      {
        onboardingHref ? (
          <a
            href={onboardingHref}
            class="text-xs tracking-tight text-slate-500 underline-offset-2 transition hover:text-slate-700 hover:underline"
          >
            用引导问卷生成初稿
          </a>
        ) : null
      }
    </div>
  </div>

  <div data-profile-editor-panel class="mt-4 hidden rounded-md border border-slate-100 bg-white px-4 py-4">
    <label class="block text-sm tracking-tight text-slate-600">
      <span class="mb-2 block text-xs uppercase tracking-[0.18em] text-slate-400">Markdown Prompt</span>
      <textarea
        data-profile-input
        rows="12"
        class="min-h-[240px] w-full rounded-md border border-slate-100 bg-white px-3 py-3 font-mono text-sm leading-7 text-slate-700 outline-none transition focus:border-brand-blue/40"
      ></textarea>
    </label>

    <div data-profile-status class="hidden mt-4 rounded-md border px-3 py-2 text-sm leading-6"></div>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <button
        type="button"
        data-profile-save
        class="inline-flex items-center justify-center rounded-md border border-slate-100 bg-brand-surface/55 px-4 py-2 text-sm tracking-tight text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface"
      >
        保存画像
      </button>
      <button
        type="button"
        data-profile-cancel
        class="inline-flex items-center justify-center rounded-md border border-transparent px-3 py-2 text-sm tracking-tight text-slate-500 transition hover:border-slate-200 hover:bg-slate-50 hover:text-slate-700"
      >
        取消
      </button>
    </div>
  </div>
</section>

<script>
  import {
    getGlobalProfile,
    getKnowledgeBaseProfile,
    updateGlobalProfile,
    updateKnowledgeBaseProfile,
  } from '../../lib/api/client';
  import { recordAction } from '../../lib/runtime-context';

  const editors = Array.from(document.querySelectorAll('[data-profile-editor]'));

  function stripMarkdown(source = '') {
    return source
      .replace(/^#+\s*/gm, '')
      .replace(/^\s*[-*]\s*/gm, '')
      .replace(/`{1,3}/g, '')
      .replace(/\[(.*?)\]\((.*?)\)/g, '$1')
      .replace(/\n{2,}/g, '\n')
      .trim();
  }

  function buildDefaultTemplate(scope, knowledgeBaseId = '') {
    if (scope === 'knowledge-base') {
      return [
        '# 本知识库画像',
        '',
        `- 绑定知识库：${knowledgeBaseId || '当前知识库'}`,
        '- 当前目标：请写清这个知识库服务于什么任务，例如考试复习、项目整理或论文阅读。',
        '- 已有背景：请写清你目前掌握到什么程度，哪些内容可以跳过基础解释。',
        '- 希望输出：例如先给结论、再给结构化解释、最后给下一步建议。',
        '- 严格程度：遇到证据不足时先说明“不确定”，不要过度脑补。',
      ].join('\n');
    }

    return [
      '# 全局学习画像',
      '',
      '- 偏好语言：简体中文',
      '- 学习目标：请用 1-2 句话描述你最近最重要的学习目标。',
      '- 解释风格：例如先讲框架、再讲细节；或更偏练习导向。',
      '- 难度偏好：例如从基础到进阶，或直接进入高密度总结。',
      '- AI 扮演角色：例如耐心助教、严谨审稿人、复盘搭子。',
      '- 回答约束：如果材料证据不足，请先指出不确定点，再给保守建议。',
    ].join('\n');
  }

  function setStatus(element, message = '', tone = 'info') {
    if (!element) return;
    if (!message) {
      element.className = 'hidden mt-4 rounded-md border px-3 py-2 text-sm leading-6';
      element.textContent = '';
      return;
    }

    const toneClasses = {
      info: 'border-slate-100 bg-white text-slate-600',
      success: 'border-brand-blue/30 bg-brand-surface/35 text-slate-700',
      error: 'border-brand-sand/60 bg-brand-sand/35 text-slate-700',
    };

    element.className = `mt-4 rounded-md border px-3 py-2 text-sm leading-6 ${toneClasses[tone] || toneClasses.info}`;
    element.textContent = message;
  }

  async function loadProfile(root, { silent = false } = {}) {
    const scope = root.getAttribute('data-scope') || 'global';
    const knowledgeBaseId = root.getAttribute('data-knowledge-base-id') || '';
    const preview = root.querySelector('[data-profile-preview]');
    const meta = root.querySelector('[data-profile-meta]');
    const input = root.querySelector('[data-profile-input]');
    const status = root.querySelector('[data-profile-status]');

    try {
      const profile =
        scope === 'knowledge-base'
          ? await getKnowledgeBaseProfile(knowledgeBaseId)
          : await getGlobalProfile();

      const content = String(profile.content || '').trim();
      const previewText = stripMarkdown(content);

      if (preview) {
        preview.textContent = previewText
          ? previewText.slice(0, 220) + (previewText.length > 220 ? '…' : '')
          : scope === 'knowledge-base'
            ? '还没有为这个知识库写 prompt 画像。你可以补充学习目标、背景和输出偏好。'
            : '还没有全局画像。建议先用问卷生成初稿，再继续手动润色。';
      }
      if (meta) {
        meta.textContent = profile.updatedAt
          ? `最近更新：${new Date(profile.updatedAt).toLocaleString('zh-CN')}`
          : '尚未保存';
      }
      if (input) {
        input.value = content || buildDefaultTemplate(scope, knowledgeBaseId);
      }
      if (!silent) {
        setStatus(status, '');
      }
    } catch (error) {
      console.error('Failed to load profile:', error);
      if (preview) {
        preview.textContent = '画像读取失败，请稍后重试。';
      }
      if (meta) {
        meta.textContent = '读取失败';
      }
      setStatus(status, error instanceof Error ? error.message : '画像读取失败。', 'error');
    }
  }

  editors.forEach((root) => {
    const panel = root.querySelector('[data-profile-editor-panel]');
    const toggle = root.querySelector('[data-profile-toggle]');
    const cancel = root.querySelector('[data-profile-cancel]');
    const save = root.querySelector('[data-profile-save]');
    const refresh = root.querySelector('[data-profile-refresh]');
    const input = root.querySelector('[data-profile-input]');
    const status = root.querySelector('[data-profile-status]');
    const scope = root.getAttribute('data-scope') || 'global';
    const knowledgeBaseId = root.getAttribute('data-knowledge-base-id') || '';

    const openEditor = () => {
      panel?.classList.remove('hidden');
      input?.focus();
    };

    const closeEditor = () => {
      panel?.classList.add('hidden');
      setStatus(status, '');
    };

    toggle?.addEventListener('click', () => {
      if (panel?.classList.contains('hidden')) {
        openEditor();
      } else {
        closeEditor();
      }
    });

    cancel?.addEventListener('click', () => {
      closeEditor();
    });

    refresh?.addEventListener('click', () => {
      void loadProfile(root);
    });

    save?.addEventListener('click', async () => {
      const content = String(input?.value || '').trim();
      if (!content) {
        setStatus(status, '画像内容不能为空。', 'error');
        return;
      }

      try {
        setStatus(status, '正在保存画像...', 'info');
        const profile =
          scope === 'knowledge-base'
            ? await updateKnowledgeBaseProfile(knowledgeBaseId, content)
            : await updateGlobalProfile(content);

        recordAction(scope === 'knowledge-base' ? 'knowledge_base_profile_saved' : 'global_profile_saved', {
          knowledgeBaseId,
        });

        setStatus(status, '画像已保存，新的 prompt 会用于后续 AI 回答。', 'success');
        await loadProfile(root, { silent: true });
        root.dispatchEvent(
          new CustomEvent('wayfare-profile-updated', {
            bubbles: true,
            detail: profile,
          })
        );
      } catch (error) {
        console.error('Failed to save profile:', error);
        setStatus(status, error instanceof Error ? error.message : '画像保存失败。', 'error');
      }
    });

    void loadProfile(root, { silent: true });
  });
</script>
