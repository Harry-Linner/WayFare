---
import { MOCK_CHAT, MOCK_CHAT_DASHBOARD } from '../../constants/mockData';

export interface Props {
  isOpen?: boolean;
  pageType?: 'document' | 'dashboard';
}

const { isOpen = false, pageType = 'document' } = Astro.props;
const chatData = pageType === 'dashboard' ? MOCK_CHAT_DASHBOARD : MOCK_CHAT;
const quickActions = pageType === 'dashboard'
  ? ['查看学习建议', '制定学习计划', '分析学习数据']
  : ['总结重点', '生成练习', '解释概念'];
---

<div 
  id="ai-assistant"
  class={`fixed right-0 top-0 h-full w-[380px] bg-brand-surface border-l border-brand-blue/20 flex flex-col transform transition-transform duration-300 ease-in-out z-40 ${
    isOpen ? 'translate-x-0' : 'translate-x-full'
  }`}
>
  <div class="p-4 border-b border-brand-blue/20 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 bg-brand-blue rounded-full flex items-center justify-center text-white text-sm font-bold">AI</div>
      <div>
        <h3 class="font-bold text-gray-800">AI 学习助手</h3>
        <div class="flex items-center gap-1">
          <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
          <span class="text-xs text-gray-500">在线</span>
        </div>
      </div>
    </div>
    <button id="close-ai-assistant" class="p-2 hover:bg-gray-100 rounded-lg transition-colors" title="关闭助手">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="flex-1 overflow-y-auto p-4 space-y-4" id="ai-chat-messages">
    {chatData.map((msg) => (
      <div class={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
        <div class={`max-w-[80%] p-3 rounded-2xl ${
          msg.role === 'user' ? 'bg-brand-blue text-white' : 'bg-white shadow-sm border border-gray-100'
        }`}>
          {msg.content}
        </div>
      </div>
    ))}
  </div>

  <div class="p-4 bg-white/50 border-t border-brand-blue/10">
    <div class="relative">
      <textarea 
        id="ai-input"
        placeholder="输入你的问题..."
        class="w-full pl-4 pr-12 py-3 rounded-xl border-none focus:ring-2 focus:ring-brand-blue bg-white resize-none"
        rows="2"
      ></textarea>
      <button 
        id="ai-send-btn"
        class="absolute right-3 bottom-3 w-8 h-8 bg-brand-blue text-white rounded-full hover:opacity-90 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
        title="发送消息"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </button>
    </div>
    
    <div class="flex gap-2 mt-3 flex-wrap" id="ai-quick-actions">
      {quickActions.map((action) => (
        <button class="quick-action-btn px-3 py-1 text-xs bg-gray-100 text-gray-600 rounded-lg hover:bg-gray-200 transition-colors">
          {action}
        </button>
      ))}
    </div>
  </div>
</div>

<div 
  id="ai-assistant-overlay"
  class={`fixed inset-0 bg-black/20 transition-opacity duration-300 z-30 ${
    isOpen ? 'opacity-100' : 'opacity-0 pointer-events-none'
  }`}
></div>

<script>
  import { demoScenarios } from '../../data/demoScenarios';
  import type { ApiChatHistoryMessage } from '../../types/sharedtypes';

  const aiAssistant = document.getElementById('ai-assistant');
  const overlay = document.getElementById('ai-assistant-overlay');
  const closeBtn = document.getElementById('close-ai-assistant');
  const sendBtn = document.getElementById('ai-send-btn');
  const input = document.getElementById('ai-input') as HTMLTextAreaElement;
  const messagesContainer = document.getElementById('ai-chat-messages');
  const quickActionsContainer = document.getElementById('ai-quick-actions');

  const fallbackMessages: ApiChatHistoryMessage[] = Array.from(messagesContainer?.children ?? []).map((_, index) => ({
    id: `fallback-${index}`,
    role: 'assistant',
    content: (messagesContainer?.children[index] as HTMLElement)?.innerText || ''
  }));

  let activeScenarioId: string | null = null;
  let thinkingTimer: number | null = null;

  function closeAIAssistant() {
    aiAssistant?.classList.add('translate-x-full');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    window.dispatchEvent(new CustomEvent('ai-assistant-closed'));
  }

  function openAIAssistant() {
    aiAssistant?.classList.remove('translate-x-full');
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    input?.focus();
    window.dispatchEvent(new CustomEvent('ai-assistant-opened'));
  }

  closeBtn?.addEventListener('click', closeAIAssistant);
  overlay?.addEventListener('click', closeAIAssistant);

  function escapeHtml(value: string) {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function renderInitialMessages(messages: ApiChatHistoryMessage[]) {
    if (!messagesContainer) return;
    messagesContainer.innerHTML = '';
    messages.forEach((msg) => renderMessage(msg.role as 'user' | 'assistant', msg.content));
  }

  function renderQuickActions(actions: string[]) {
    if (!quickActionsContainer) return;
    quickActionsContainer.innerHTML = actions.map((action) => `
      <button class="quick-action-btn px-3 py-1 text-xs bg-gray-100 text-gray-600 rounded-lg hover:bg-gray-200 transition-colors">
        ${escapeHtml(action)}
      </button>
    `).join('');

    quickActionsContainer.querySelectorAll<HTMLButtonElement>('.quick-action-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.textContent?.trim();
        if (input && text) {
          input.value = text;
          input.focus();
        }
      });
    });
  }

  function renderMessage(role: 'user' | 'assistant', content: string) {
    const wrapper = document.createElement('div');
    wrapper.className = `flex ${role === 'user' ? 'justify-end' : 'justify-start'}`;
    wrapper.innerHTML = `
      <div class="max-w-[80%] p-3 rounded-2xl ${role === 'user' ? 'bg-brand-blue text-white' : 'bg-white shadow-sm border border-gray-100'}">
        ${content}
      </div>
    `;
    messagesContainer?.appendChild(wrapper);
    messagesContainer?.scrollTo(0, messagesContainer.scrollHeight);
  }

  function renderThinking(thinkingSteps: string[]) {
    if (!messagesContainer) return null;
    const wrapper = document.createElement('div');
    wrapper.className = 'flex justify-start';
    wrapper.innerHTML = `
      <div class="max-w-[80%] p-3 rounded-2xl bg-white shadow-sm border border-gray-100 text-sm leading-6 text-gray-600">
        <div class="font-semibold text-gray-800 mb-1">AI 正在处理你的问题...</div>
        <div id="ai-thinking-text">${escapeHtml(thinkingSteps[0] || '正在组织回答')}</div>
      </div>
    `;
    messagesContainer.appendChild(wrapper);
    messagesContainer.scrollTo(0, messagesContainer.scrollHeight);

    const thinkingText = wrapper.querySelector('#ai-thinking-text') as HTMLElement | null;
    let stepIndex = 0;
    thinkingTimer = window.setInterval(() => {
      stepIndex = (stepIndex + 1) % thinkingSteps.length;
      if (thinkingText) thinkingText.textContent = thinkingSteps[stepIndex];
    }, 800);

    return wrapper;
  }

  async function streamAssistantReply(chunks: string[]) {
    if (!messagesContainer) return;
    const wrapper = document.createElement('div');
    wrapper.className = 'flex justify-start';
    wrapper.innerHTML = `
      <div class="max-w-[80%] p-3 rounded-2xl bg-white shadow-sm border border-gray-100">
        <div class="streaming-reply-wrap">
          <span id="ai-streaming-text"></span>
          <span class="streaming-cursor">|</span>
        </div>
      </div>
    `;
    messagesContainer.appendChild(wrapper);
    const textEl = wrapper.querySelector('#ai-streaming-text') as HTMLElement | null;
    const cursorEl = wrapper.querySelector('.streaming-cursor') as HTMLElement | null;

    let currentText = '';
    for (const chunk of chunks) {
      currentText += chunk;
      if (textEl) textEl.textContent = currentText;
      messagesContainer.scrollTo(0, messagesContainer.scrollHeight);
      await new Promise((resolve) => setTimeout(resolve, 360));
    }

    cursorEl?.classList.add('opacity-40');
  }

  function getScenarioReply(message: string) {
    if (!activeScenarioId) return null;
    const scenario = demoScenarios[activeScenarioId];
    if (!scenario) return null;

    const normalizedMessage = message.toLowerCase();
    const matchedRule = scenario.assistant.rules.find((rule) =>
      rule.keywords.some((keyword) => normalizedMessage.includes(keyword.toLowerCase()))
    );

    if (matchedRule) {
      return {
        thinkingSteps: matchedRule.thinkingSteps,
        streamChunks: matchedRule.streamChunks
      };
    }

    return {
      thinkingSteps: scenario.assistant.defaultThinkingSteps,
      streamChunks: scenario.assistant.defaultStreamChunks
    };
  }

  async function sendMessage() {
    const message = input?.value.trim();
    if (!message || !messagesContainer) return;

    renderMessage('user', escapeHtml(message));
    input.value = '';
    input.style.height = 'auto';

    const scenarioReply = getScenarioReply(message);
    if (scenarioReply) {
      const thinkingEl = renderThinking(scenarioReply.thinkingSteps);
      await new Promise((resolve) => setTimeout(resolve, 2400));
      if (thinkingTimer) {
        clearInterval(thinkingTimer);
        thinkingTimer = null;
      }
      thinkingEl?.remove();
      await streamAssistantReply(scenarioReply.streamChunks);
      return;
    }

    setTimeout(() => {
      renderMessage('assistant', '我已经收到你的问题。如果这是一个普通知识库场景，我可以继续为你总结重点、解释概念，或者把内容整理成练习题。');
    }, 700);
  }

  sendBtn?.addEventListener('click', sendMessage);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  input?.addEventListener('input', () => {
    input.style.height = 'auto';
    input.style.height = input.scrollHeight + 'px';
  });

  quickActionsContainer?.querySelectorAll<HTMLButtonElement>('.quick-action-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.textContent?.trim();
      if (input && text) {
        input.value = text;
        input.focus();
      }
    });
  });

  window.addEventListener('wayfare:assistant-config', ((event: CustomEvent<{ scenarioId: string | null }>) => {
    activeScenarioId = event.detail?.scenarioId ?? null;
    if (activeScenarioId && demoScenarios[activeScenarioId]) {
      const scenario = demoScenarios[activeScenarioId];
      renderInitialMessages(scenario.assistant.initialMessages);
      renderQuickActions(scenario.assistant.quickActions);
    } else {
      renderInitialMessages(fallbackMessages);
      renderQuickActions(['总结重点', '生成练习', '解释概念']);
    }
  }) as EventListener);

  (window as any).openAIAssistant = openAIAssistant;
  (window as any).closeAIAssistant = closeAIAssistant;
</script>

<style>
  #ai-chat-messages::-webkit-scrollbar {
    width: 6px;
  }
  
  #ai-chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }
  
  #ai-chat-messages::-webkit-scrollbar-thumb {
    background: #e5e7eb;
    border-radius: 3px;
  }
  
  #ai-chat-messages::-webkit-scrollbar-thumb:hover {
    background: #d1d5db;
  }

  #ai-chat-messages > div {
    animation: messageSlideIn 0.3s ease-out;
  }
  
  @keyframes messageSlideIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .streaming-reply-wrap {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .streaming-cursor {
    display: inline-block;
    margin-left: 2px;
    color: #3b82f6;
    animation: blinkCursor 0.9s steps(1) infinite;
  }

  @keyframes blinkCursor {
    0%, 50% {
      opacity: 1;
    }
    51%, 100% {
      opacity: 0;
    }
  }
</style>
