---
import { MOCK_CHAT, MOCK_CHAT_DASHBOARD } from '../../constants/mockData';

export interface Props {
  isOpen?: boolean;
  pageType?: 'document' | 'dashboard';
}

const { isOpen = false, pageType = 'document' } = Astro.props;
const chatData = pageType === 'dashboard' ? MOCK_CHAT_DASHBOARD : MOCK_CHAT;
---

<div
  id="ai-assistant"
  class={`fixed right-0 top-0 z-40 flex h-full w-[380px] flex-col border-l border-slate-100 bg-[#fcfcf8]/96 backdrop-blur-sm transition-transform duration-300 ease-in-out ${
    isOpen ? 'translate-x-0' : 'translate-x-full'
  }`}
>
  <div class="border-b border-slate-100 px-5 py-4">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Study Companion</p>
        <h3 class="mt-1 text-base font-medium tracking-tight text-slate-800">AI 学习助手</h3>
        <p class="mt-1 text-sm leading-6 text-slate-500">更偏向解释与整理，不打断你的阅读节奏。</p>
      </div>
      <button id="close-ai-assistant" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-100 bg-white text-slate-500 transition hover:border-slate-200 hover:text-slate-700" title="关闭助手">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="ai-chat-messages" class="flex-1 space-y-4 overflow-y-auto px-5 py-5">
    {chatData.map((msg) => (
      <div class={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
        <div class={`max-w-[88%] rounded-lg border px-4 py-3 text-sm leading-7 tracking-tight ${msg.role === 'user' ? 'border-brand-blue/30 bg-brand-surface/70 text-slate-700' : 'border-slate-100 bg-white text-slate-600'}`}>
          {msg.content}
        </div>
      </div>
    ))}
  </div>

  <div class="border-t border-slate-100 px-5 py-4">
    <div class="mb-3 flex flex-wrap gap-2">
      <button type="button" class="quick-action-btn rounded-md border border-slate-100 bg-white px-3 py-1.5 text-xs tracking-tight text-slate-500 transition hover:border-brand-blue/40 hover:bg-brand-surface/30 hover:text-slate-700">总结重点</button>
      <button type="button" class="quick-action-btn rounded-md border border-slate-100 bg-white px-3 py-1.5 text-xs tracking-tight text-slate-500 transition hover:border-brand-blue/40 hover:bg-brand-surface/30 hover:text-slate-700">生成练习</button>
      <button type="button" class="quick-action-btn rounded-md border border-slate-100 bg-white px-3 py-1.5 text-xs tracking-tight text-slate-500 transition hover:border-brand-blue/40 hover:bg-brand-surface/30 hover:text-slate-700">解释概念</button>
    </div>

    <div class="rounded-lg border border-slate-100 bg-white p-3">
      <textarea id="ai-input" placeholder="输入你的问题..." class="min-h-[72px] w-full resize-none border-none bg-transparent p-0 text-sm leading-7 tracking-tight text-slate-700 placeholder:text-slate-400 focus:outline-none focus:ring-0" rows="2"></textarea>
      <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3">
        <span class="text-[11px] uppercase tracking-[0.18em] text-slate-400">Project 1</span>
        <button id="ai-send-btn" class="flex items-center gap-2 rounded-md border border-slate-100 bg-brand-surface/60 px-3 py-2 text-sm tracking-tight text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface disabled:cursor-not-allowed disabled:opacity-50" title="发送消息">
          <span>发送</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h13.5m0 0-4.5-4.5M18 12l-4.5 4.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<div id="ai-assistant-overlay" class={`fixed inset-0 z-30 bg-slate-900/5 transition-opacity duration-300 ${isOpen ? 'opacity-100' : 'pointer-events-none opacity-0'}`}></div>

<script>
  import { chat } from '../../lib/api';

  const aiAssistant = document.getElementById('ai-assistant');
  const overlay = document.getElementById('ai-assistant-overlay');
  const closeBtn = document.getElementById('close-ai-assistant');
  const sendBtn = document.getElementById('ai-send-btn') as HTMLButtonElement | null;
  const input = document.getElementById('ai-input') as HTMLTextAreaElement | null;
  const messagesContainer = document.getElementById('ai-chat-messages');

  function closeAIAssistant() {
    aiAssistant?.classList.add('translate-x-full');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    window.dispatchEvent(new CustomEvent('ai-assistant-closed'));
  }

  function openAIAssistant() {
    aiAssistant?.classList.remove('translate-x-full');
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    input?.focus();
    window.dispatchEvent(new CustomEvent('ai-assistant-opened'));
  }

  function appendMessage(role, content, metaLabel = '') {
    if (!messagesContainer) return;
    const wrapper = document.createElement('div');
    wrapper.className = `flex ${role === 'user' ? 'justify-end' : 'justify-start'}`;

    const bubble = document.createElement('div');
    bubble.className = role === 'user'
      ? 'max-w-[88%] rounded-lg border border-brand-blue/30 bg-brand-surface/70 px-4 py-3 text-sm leading-7 tracking-tight text-slate-700'
      : 'max-w-[88%] rounded-lg border border-slate-100 bg-white px-4 py-3 text-sm leading-7 tracking-tight text-slate-600 whitespace-pre-wrap';

    if (metaLabel) {
      const meta = document.createElement('div');
      meta.className = 'mb-1 text-[11px] uppercase tracking-[0.18em] text-slate-400';
      meta.textContent = metaLabel;
      bubble.appendChild(meta);
    }

    const body = document.createElement('div');
    body.textContent = content;
    bubble.appendChild(body);

    wrapper.appendChild(bubble);
    messagesContainer.appendChild(wrapper);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  closeBtn?.addEventListener('click', closeAIAssistant);
  overlay?.addEventListener('click', closeAIAssistant);

  async function submitMessage(payload) {
    const visibleMessage = typeof payload === 'string' ? payload : payload.visibleMessage;
    const actualPrompt = typeof payload === 'string' ? payload : payload.actualPrompt;
    const metaLabel = typeof payload === 'string' ? '' : payload.metaLabel || '';

    if (!actualPrompt || !messagesContainer || !input) return;

    appendMessage('user', visibleMessage || actualPrompt, metaLabel);
    input.value = '';
    input.style.height = 'auto';
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
    sendBtn?.setAttribute('disabled', 'true');

    try {
      const activeKnowledgeBaseId = (window as any).activeKnowledgeBaseId;
      const response = await chat(1, actualPrompt, activeKnowledgeBaseId);
      appendMessage('assistant', response.content || '模型没有返回内容');
    } catch (error) {
      console.error('AI chat request failed:', error);
      const errorMessage = error instanceof Error ? error.message : '请求失败，请稍后重试';
      appendMessage('assistant', `请求失败：${errorMessage}`);
    } finally {
      sendBtn?.removeAttribute('disabled');
    }
  }

  async function sendMessage() {
    const message = input?.value.trim();
    if (!message) return;
    await submitMessage(message);
  }

  sendBtn?.addEventListener('click', () => { void sendMessage(); });
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      void sendMessage();
    }
  });
  input?.addEventListener('input', () => {
    if (!input) return;
    input.style.height = 'auto';
    input.style.height = `${input.scrollHeight}px`;
  });

  document.querySelectorAll('#ai-assistant .quick-action-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.textContent?.trim() || '';
      if (input) {
        input.value = `${text}：`;
        input.focus();
      }
    });
  });

  (window as any).openAIAssistant = openAIAssistant;
  (window as any).closeAIAssistant = closeAIAssistant;
  (window as any).askAIAssistant = async (payload) => {
    if (!payload) return;
    openAIAssistant();
    await submitMessage(payload);
  };
</script>

<style>
  #ai-chat-messages > div { animation: messageSlideIn 0.24s ease-out; }
  @keyframes messageSlideIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
