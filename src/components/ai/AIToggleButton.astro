---
export interface Props {
  position?: 'left' | 'right';
  bottom?: string;
}

const { position = 'right', bottom = '6rem' } = Astro.props;
---

<button
  id="ai-toggle-btn"
  class={`fixed ${position}-5 z-50 flex items-center gap-2 rounded-md border border-slate-100 bg-white/92 px-3 py-2 text-sm tracking-tight text-slate-600 backdrop-blur-sm transition hover:border-brand-blue/40 hover:bg-brand-surface/60 hover:text-slate-700`}
  style={`bottom: ${bottom}`}
  title="AI 学习助手"
>
  <svg id="ai-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.75h4.5m-4.5 16.5h4.5M5.25 8.25h13.5M5.25 15.75h13.5M8.25 12h7.5" />
  </svg>
  <svg id="close-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
  </svg>
  <span class="hidden sm:inline">学习助手</span>
  <span id="ai-notification" class="hidden h-1.5 w-1.5 rounded-full bg-brand-sand"></span>
</button>

<script>
  const toggleBtn = document.getElementById('ai-toggle-btn');
  const aiIcon = document.getElementById('ai-icon');
  const closeIcon = document.getElementById('close-icon');
  const notification = document.getElementById('ai-notification');

  let isOpen = false;

  function applyState() {
    aiIcon?.classList.toggle('hidden', isOpen);
    closeIcon?.classList.toggle('hidden', !isOpen);
    toggleBtn?.classList.toggle('bg-brand-surface/80', isOpen);
    toggleBtn?.classList.toggle('border-brand-blue/40', isOpen);
  }

  function toggleAIAssistant() {
    isOpen = !isOpen;
    applyState();
    if (isOpen) {
      window.openAIAssistant?.();
      notification?.classList.add('hidden');
    } else {
      window.closeAIAssistant?.();
    }
  }

  toggleBtn?.addEventListener('click', toggleAIAssistant);
  window.addEventListener('ai-assistant-opened', () => {
    isOpen = true;
    applyState();
    notification?.classList.add('hidden');
  });
  window.addEventListener('ai-assistant-closed', () => {
    isOpen = false;
    applyState();
  });
  setTimeout(() => {
    if (!isOpen) notification?.classList.remove('hidden');
  }, 5000);
  notification?.addEventListener('click', (e) => {
    e.stopPropagation();
    notification?.classList.add('hidden');
  });
  window.toggleAIAssistant = toggleAIAssistant;
</script>
