---
import type { Annotation } from '../../types/sharedtypes';

interface Props {
  annotation: Annotation;
}

const { annotation } = Astro.props;

const priorityStyles = {
  critical: 'border-priority-critical/70 bg-white text-priority-critical',
  important: 'border-priority-important/80 bg-white text-[#B98839]',
  normal: 'border-brand-blue/70 bg-white text-slate-600',
  low: 'border-slate-300 bg-white text-slate-400'
};

const scale = 0.82 + annotation.weight * 0.32;
---

<div
  class={`group absolute z-20 flex cursor-pointer items-center justify-center rounded-full border transition-transform hover:scale-105 ${priorityStyles[annotation.priority]}`}
  style={`
    left: ${annotation.boundingBox.x}px;
    top: ${annotation.boundingBox.y}px;
    width: ${22 * scale}px;
    height: ${22 * scale}px;
  `}
  data-annotation-id={annotation.id}
>
  <span class="pointer-events-none text-[10px] leading-none">
    {annotation.priority === 'critical' ? '!' : '·'}
  </span>

  <div class="pointer-events-auto absolute bottom-full left-1/2 z-50 mb-3 hidden w-64 -translate-x-1/2 rounded-md border border-slate-100 bg-white p-4 text-left group-hover:block">
    <div class="mb-3 flex items-center justify-between">
      <span class="rounded-sm bg-brand-surface/60 px-2 py-1 text-[10px] uppercase tracking-[0.18em] text-slate-500">
        {annotation.priority}
      </span>
      <span class="text-[11px] tracking-tight text-slate-400">考频 {annotation.frequency}</span>
    </div>

    <h4 class="text-sm font-medium tracking-tight text-slate-800">{annotation.knowledgePoint}</h4>
    <p class="mt-2 text-sm leading-6 text-slate-500">{annotation.aiComment}</p>

    <button
      class="mt-4 inline-flex items-center gap-2 rounded-md border border-slate-100 bg-brand-surface/40 px-3 py-2 text-xs tracking-tight text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface/70"
      data-ask-btn
    >
      <span>继续提问</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h13.5m0 0-4.5-4.5M18 12l-4.5 4.5" />
      </svg>
    </button>

    <div class="absolute left-1/2 top-full h-3 w-3 -translate-x-1/2 -translate-y-1/2 rotate-45 border-b border-r border-slate-100 bg-white"></div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-ask-btn]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
    });
  });
</script>
