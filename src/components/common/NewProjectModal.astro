<dialog id="new-project-modal" class="rounded-lg border-none bg-transparent p-0 backdrop:bg-slate-900/10">
  <div class="w-[520px] max-w-[calc(100vw-2rem)] rounded-lg border border-slate-100 bg-white p-6">
    <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
      <div>
        <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Quick Create</p>
        <h2 class="mt-2 text-xl font-medium tracking-tight text-slate-800">新建知识库项目</h2>
      </div>
      <button onclick="this.closest('dialog').close()" class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-100 bg-white text-slate-500 transition hover:border-slate-200 hover:text-slate-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <form id="new-project-form" class="mt-6 space-y-6">
      <div>
        <label class="mb-2 block text-sm font-medium tracking-tight text-slate-700">项目标识符</label>
        <input
          type="text"
          name="kbId"
          required
          placeholder="例如：2026_cs_408"
          class="w-full rounded-md border border-slate-100 bg-white px-4 py-3 text-sm tracking-tight text-slate-700 placeholder:text-slate-400 outline-none transition focus:border-brand-blue/40"
        />
      </div>

      <div>
        <p class="mb-3 text-sm font-medium tracking-tight text-slate-700">学习模式</p>
        <div class="grid gap-3 md:grid-cols-2">
          <label class="block cursor-pointer">
            <input type="radio" name="goal" value="structured" class="peer sr-only" checked />
            <div class="rounded-md border border-slate-100 bg-white px-4 py-4 transition peer-checked:border-brand-blue/40 peer-checked:bg-brand-surface/25 hover:border-brand-blue/30">
              <div class="text-sm font-medium tracking-tight text-slate-700">规律学习</div>
              <div class="mt-1 text-xs leading-6 text-slate-500">适合长期阅读、持续整理与计划推进。</div>
            </div>
          </label>
          <label class="block cursor-pointer">
            <input type="radio" name="goal" value="casual" class="peer sr-only" />
            <div class="rounded-md border border-slate-100 bg-white px-4 py-4 transition peer-checked:border-brand-blue/40 peer-checked:bg-brand-surface/25 hover:border-brand-blue/30">
              <div class="text-sm font-medium tracking-tight text-slate-700">随性探索</div>
              <div class="mt-1 text-xs leading-6 text-slate-500">更适合短期记录、临时摘录和自由浏览。</div>
            </div>
          </label>
        </div>
      </div>

      <div class="rounded-md border border-slate-100 bg-brand-surface/25 px-4 py-4">
        <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Path Preview</p>
        <div class="mt-2 flex items-center justify-between gap-3">
          <p id="path-preview" class="truncate text-sm tracking-tight text-slate-600">/Users/Docs/KnowledgeBase/new-repo</p>
          <button type="button" id="btn-change-path" class="rounded-md border border-slate-100 bg-white px-3 py-2 text-xs tracking-tight text-slate-500 transition hover:border-brand-blue/40 hover:bg-brand-surface/30 hover:text-slate-700">
            更换路径
          </button>
        </div>
      </div>

      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-slate-100 bg-brand-surface/55 px-4 py-3 text-sm tracking-tight text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface">
        创建并进入工作台
      </button>
    </form>
  </div>
</dialog>

<script>
  const form = document.getElementById('new-project-form');
  const pathPreview = document.getElementById('path-preview');
  const changePathBtn = document.getElementById('btn-change-path');

  changePathBtn?.addEventListener('click', () => {
    const customPath = prompt('输入新的知识库路径', pathPreview?.textContent || '');
    if (customPath && pathPreview) {
      pathPreview.textContent = customPath;
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const kbId = formData.get('kbId') || 'default';
    alert(`项目 ${kbId} 初始化成功，正在跳转至工作台...`);
    window.location.href = `/workspace/${kbId}`;
  });
</script>
