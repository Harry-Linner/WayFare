---
import type { DemoScenario } from '../../types/sharedtypes';

interface Props {
  scenario: DemoScenario;
}

const { scenario } = Astro.props;
---

<dialog id="detected-import-action-modal" class="backdrop:bg-black/50 p-0 rounded-3xl shadow-2xl border-none w-[560px] max-w-[calc(100vw-2rem)]">
  <div class="bg-white p-6 md:p-7 flex flex-col gap-5">
    <div>
      <div class="text-xs uppercase tracking-[0.2em] text-gray-400">AI 检测结果</div>
      <h3 class="mt-2 text-2xl font-black text-gray-800">{scenario.detectedTitle}</h3>
      <p class="mt-2 text-sm leading-6 text-gray-500">{scenario.detectedDescription}</p>
    </div>

    <div class="space-y-3">
      {scenario.options.filter((option) => option.processingMode !== 'custom').map((option) => (
        <button
          class="detected-option-btn w-full rounded-2xl border border-brand-blue/15 bg-brand-cream/40 px-5 py-4 text-left transition hover:border-brand-blue/40 hover:bg-brand-blue/5"
          data-option-id={option.id}
          data-processing-mode={option.processingMode}
          data-processing-label={option.processingLabel}
        >
          <div class="text-base font-bold text-gray-800">{option.label}</div>
          <div class="mt-1 text-sm text-gray-500">{option.description}</div>
        </button>
      ))}

      <button
        id="open-custom-detected-option"
        type="button"
        class="w-full rounded-2xl border border-brand-blue/15 bg-brand-cream/40 px-5 py-4 text-left transition hover:border-brand-blue/40 hover:bg-brand-blue/5"
      >
        <div class="text-base font-bold text-gray-800">其他（自定义）</div>
        <div class="mt-1 text-sm text-gray-500">输入你希望 WayFare 对这份资料执行的处理方式</div>
      </button>
    </div>

    <div id="custom-detected-option-panel" class="hidden rounded-2xl border border-brand-blue/10 bg-brand-cream/40 p-4 space-y-3">
      <label for="custom-detected-option-input" class="block text-sm font-medium text-gray-700">自定义处理方式</label>
      <input
        id="custom-detected-option-input"
        type="text"
        maxlength="60"
        placeholder="例如：为这篇论文生成一个分层批注，让我更好理解"
        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-blue focus:border-brand-blue transition-all"
      />
      <div class="flex justify-end gap-2">
        <button id="cancel-custom-detected-option" type="button" class="px-4 py-2 border border-gray-300 rounded-xl text-sm text-gray-600 hover:bg-gray-50">
          取消
        </button>
        <button id="confirm-custom-detected-option" type="button" class="px-4 py-2 bg-brand-blue text-white rounded-xl text-sm hover:opacity-90">
          确定
        </button>
      </div>
    </div>

    <div class="flex justify-end">
      <button id="close-detected-import-action-modal" type="button" class="px-4 py-2 text-sm text-gray-400 hover:text-gray-600">
        暂不处理
      </button>
    </div>
  </div>
</dialog>

<script>
  const detectedImportModal = document.getElementById('detected-import-action-modal') as HTMLDialogElement | null;
  const customPanel = document.getElementById('custom-detected-option-panel');
  const customInput = document.getElementById('custom-detected-option-input') as HTMLInputElement | null;
  const openCustomBtn = document.getElementById('open-custom-detected-option');
  const cancelCustomBtn = document.getElementById('cancel-custom-detected-option');
  const confirmCustomBtn = document.getElementById('confirm-custom-detected-option');
  const closeModalBtn = document.getElementById('close-detected-import-action-modal');

  function emitDetectedOptionSelected(detail: { processingMode: string; processingLabel: string }) {
    window.dispatchEvent(new CustomEvent('demo:import-option-selected', { detail }));
    detectedImportModal?.close();
    customPanel?.classList.add('hidden');
    if (customInput) customInput.value = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.detected-option-btn').forEach((button) => {
    button.addEventListener('click', () => {
      emitDetectedOptionSelected({
        processingMode: button.dataset.processingMode ?? 'raw-only',
        processingLabel: button.dataset.processingLabel ?? button.textContent?.trim() ?? '未命名处理方式'
      });
    });
  });

  openCustomBtn?.addEventListener('click', () => {
    customPanel?.classList.remove('hidden');
    customInput?.focus();
  });

  cancelCustomBtn?.addEventListener('click', () => {
    customPanel?.classList.add('hidden');
    if (customInput) customInput.value = '';
  });

  confirmCustomBtn?.addEventListener('click', () => {
    const value = customInput?.value.trim();
    if (!value) {
      customInput?.focus();
      return;
    }

    emitDetectedOptionSelected({
      processingMode: 'custom',
      processingLabel: value
    });
  });

  closeModalBtn?.addEventListener('click', () => {
    detectedImportModal?.close();
  });
</script>
