---
import type {
  AnnotationColorGroup,
  RenderReadyAnnotationDocument,
  RenderReadyHighlight,
  RenderReadyParagraph,
  RenderReadySection,
} from '../../types/sharedtypes';

interface Props {
  data: RenderReadyAnnotationDocument;
}

const { data } = Astro.props;

const colorClasses: Record<AnnotationColorGroup, string> = {
  yellow: 'bg-[#F4D35E]/40 text-gray-900 ring-[#F4D35E]/60',
  red: 'bg-[#E76F51]/22 text-gray-900 ring-[#E76F51]/50',
  blue: 'bg-[#5DADE2]/22 text-gray-900 ring-[#5DADE2]/50',
  green: 'bg-[#6BBF59]/22 text-gray-900 ring-[#6BBF59]/50',
  purple: 'bg-[#9B59B6]/22 text-gray-900 ring-[#9B59B6]/50',
};

type TextSegment =
  | { kind: 'plain'; text: string }
  | { kind: 'highlight'; text: string; highlight: RenderReadyHighlight };

function buildSegments(text: string, highlights: RenderReadyHighlight[]): TextSegment[] {
  if (highlights.length === 0) {
    return [{ kind: 'plain', text }];
  }

  const segments: TextSegment[] = [];
  let cursor = 0;

  for (const highlight of highlights) {
    const index = text.indexOf(highlight.text, cursor);
    if (index === -1) {
      continue;
    }

    if (index > cursor) {
      segments.push({ kind: 'plain', text: text.slice(cursor, index) });
    }

    segments.push({
      kind: 'highlight',
      text: highlight.text,
      highlight,
    });

    cursor = index + highlight.text.length;
  }

  if (cursor < text.length) {
    segments.push({ kind: 'plain', text: text.slice(cursor) });
  }

  return segments.length > 0 ? segments : [{ kind: 'plain', text }];
}

const sectionsWithSegments = data.sections.map((section: RenderReadySection) => ({
  ...section,
  paragraphs: section.paragraphs.map((paragraph: RenderReadyParagraph) => ({
    ...paragraph,
    segments: buildSegments(paragraph.text, paragraph.highlights),
  })),
}));
---

<div class="annotated-preview rounded-[28px] border border-brand-blue/10 bg-[#fcf8ef] shadow-sm overflow-hidden">
  <div class="sticky top-0 z-10 border-b border-brand-blue/10 bg-[#102C46] text-white">
    <div class="px-8 py-5 flex flex-col gap-4">
      <div class="flex flex-col gap-2 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <div class="text-xs uppercase tracking-[0.25em] text-white/60">AI 分层批注演示</div>
          <h2 class="mt-2 text-2xl font-black">{data.meta.title}</h2>
          <p class="mt-2 text-sm text-white/80">{data.meta.course} · {data.meta.week}</p>
        </div>
        <div class="max-w-xl rounded-2xl bg-white/10 px-4 py-3 text-sm leading-6 text-white/85">
          <span class="font-semibold text-white">任务模式：</span>{data.meta.userGoal}
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        {data.legend.map((item) => (
          <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-xs font-medium">
            <span class="inline-block h-3 w-3 rounded-full" style={`background-color: ${item.color}`}></span>
            <span>{item.label}</span>
          </div>
        ))}
      </div>

      <nav class="flex flex-wrap gap-2">
        {data.sections.map((section) => (
          <a
            href={`#${section.id}`}
            class="rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-medium text-white/90 transition hover:bg-white/20"
          >
            {section.title}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div class="px-8 py-8">
    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.6fr)_280px] gap-6 items-start">
      <article class="space-y-10 text-gray-800">
        {sectionsWithSegments.map((section) => (
          <section id={section.id} class="scroll-mt-44 space-y-5">
            <div class="flex items-center gap-3">
              <div class="h-px flex-1 bg-brand-blue/15"></div>
              <h3 class="text-lg font-black tracking-wide text-[#102C46]">{section.title}</h3>
              <div class="h-px flex-1 bg-brand-blue/15"></div>
            </div>

            <div class="space-y-5">
              {section.paragraphs.map((paragraph) => (
                <p id={paragraph.id} class="scroll-mt-44 rounded-2xl bg-white/65 px-5 py-4 text-[1.05rem] leading-8 shadow-sm border border-white/80">
                  {paragraph.segments.map((segment) =>
                    segment.kind === 'plain' ? (
                      segment.text
                    ) : (
                      <span
                        class={`rounded-md px-1.5 py-0.5 ring-1 ${colorClasses[segment.highlight.colorGroup]}`}
                        title={segment.highlight.semanticType}
                      >
                        {segment.text}
                      </span>
                    )
                  )}
                </p>
              ))}
            </div>
          </section>
        ))}
      </article>

      <aside class="space-y-3 xl:sticky xl:top-44">
        {sectionsWithSegments.map((section) =>
          section.paragraphs.map((paragraph) => (
            <a
              href={`#${paragraph.id}`}
              class="block rounded-2xl border border-brand-blue/10 bg-white/90 p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <div class="mb-3 flex items-center justify-between gap-3">
                <h4 class="text-[15px] font-bold text-[#102C46]">{paragraph.sidebarNote.title}</h4>
                <span class="rounded-full bg-brand-blue/10 px-2.5 py-1 text-[11px] font-semibold text-brand-blue">
                  {paragraph.id}
                </span>
              </div>

              <div class="space-y-2.5 text-[13px] leading-6 text-gray-600">
                <div class="rounded-xl bg-[#f6f8fb] px-3 py-2">
                  <span class="font-semibold text-gray-800">段落功能：</span>{paragraph.sidebarNote.paragraphFunction}
                </div>
                <div class="rounded-xl bg-[#f6f8fb] px-3 py-2">
                  <span class="font-semibold text-gray-800">逻辑角色：</span>{paragraph.sidebarNote.logicRole}
                </div>
                <div class="border-l-4 border-[#F4D35E] bg-[#fffaf0] px-3 py-2.5 rounded-r-xl">
                  <div class="font-semibold text-gray-800">第一层：一句话看懂</div>
                  <div class="mt-1">{paragraph.sidebarNote.layer1}</div>
                </div>
                <div class="border-l-4 border-[#5DADE2] bg-[#f5fbff] px-3 py-2.5 rounded-r-xl">
                  <div class="font-semibold text-gray-800">第二层：放进全文里看</div>
                  <div class="mt-1">{paragraph.sidebarNote.layer2}</div>
                </div>
                <div class="border-l-4 border-[#9B59B6] bg-[#faf5ff] px-3 py-2.5 rounded-r-xl">
                  <div class="font-semibold text-gray-800">第三层：转化成学习价值</div>
                  <div class="mt-1">{paragraph.sidebarNote.layer3}</div>
                </div>
                <div>
                  <span class="font-semibold text-gray-800">值得注意：</span>{paragraph.sidebarNote.worthNoticing}
                </div>
                <div>
                  <span class="font-semibold text-gray-800">潜在薄弱点：</span>{paragraph.sidebarNote.possibleWeakness}
                </div>
              </div>
            </a>
          ))
        )}
      </aside>
    </div>

    <section class="mt-10 rounded-[24px] border border-brand-blue/10 bg-white/85 p-6 shadow-sm">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
        <div class="lg:max-w-xl">
          <div class="text-xs uppercase tracking-[0.2em] text-gray-400">论证结构总览</div>
          <h3 class="mt-2 text-xl font-black text-[#102C46]">从“读懂内容”到“看清结构”</h3>
          <p class="mt-3 text-sm leading-7 text-gray-600">
            这部分用于展示 AI 学习助手如何不仅解释段落本身，还能帮助大学生提炼全文逻辑链、核心结论与最值得留意的论证优劣势。
          </p>
        </div>

        <div class="flex flex-wrap gap-2">
          {data.summary.logicChain.map((item) => (
            <span class="rounded-full bg-brand-blue/10 px-3 py-1.5 text-xs font-semibold text-brand-blue">{item}</span>
          ))}
        </div>
      </div>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="rounded-2xl bg-[#fffaf0] border border-[#F4D35E]/30 p-4">
          <div class="text-sm font-semibold text-gray-800">一句话主张</div>
          <p class="mt-2 text-sm leading-6 text-gray-600">{data.summary.oneSentenceClaim}</p>
        </div>
        <div class="rounded-2xl bg-[#f5fbff] border border-[#5DADE2]/30 p-4">
          <div class="text-sm font-semibold text-gray-800">论证最强处</div>
          <p class="mt-2 text-sm leading-6 text-gray-600">{data.summary.strongestPoint}</p>
        </div>
        <div class="rounded-2xl bg-[#f9fafb] border border-gray-200 p-4">
          <div class="text-sm font-semibold text-gray-800">论证最弱处</div>
          <p class="mt-2 text-sm leading-6 text-gray-600">{data.summary.weakestPoint}</p>
        </div>
      </div>
    </section>
  </div>
</div>
