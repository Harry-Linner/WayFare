---
import ThreePaneLayout from '../layouts/ThreePaneLayout.astro';
import ReviewCard from '../components/dashboard/ReviewCard.astro';
import '../styles/global.css';

const recentActivities = [
  { time: '2025-11-24', duration: '120 min', focus: '数据结构', mastery: 85 },
  { time: '2025-11-23', duration: '45 min', focus: '操作系统', mastery: 40 }
];
---

<ThreePaneLayout title="学习复盘中心">
  <div class="mx-auto max-w-4xl space-y-8">
    <header class="border-b border-slate-100 pb-6">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Review</p>
          <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-800">学习复盘</h1>
          <p class="mt-3 text-sm leading-7 text-slate-500">把过去几天的阅读、错误点和进度变化安静地放在一页中查看。</p>
        </div>
        <div class="border-t border-slate-100 pt-4 text-right">
          <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Current Streak</p>
          <div class="mt-2 text-2xl font-medium tracking-tight text-slate-800">12 天</div>
        </div>
      </div>
    </header>

    <div class="grid gap-5 md:grid-cols-2">
      <ReviewCard />
      <div class="flex flex-col justify-between rounded-lg border border-slate-100 bg-white px-5 py-5">
        <div>
          <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Common Mistakes</p>
          <div class="mt-5 space-y-4">
            <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
              <span class="h-2 w-2 rounded-full bg-priority-critical"></span>
              <span class="flex-1 text-sm tracking-tight text-slate-700">AVL 树中的 RL 型双旋转</span>
              <span class="text-[12px] tracking-tight text-slate-400">回顾 4 次</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="h-2 w-2 rounded-full bg-priority-important"></span>
              <span class="flex-1 text-sm tracking-tight text-slate-700">操作系统死锁的四个必要条件</span>
              <span class="text-[12px] tracking-tight text-slate-400">回顾 2 次</span>
            </div>
          </div>
        </div>

        <button class="mt-6 inline-flex items-center justify-center gap-2 rounded-md border border-slate-100 bg-brand-surface/55 px-4 py-2 text-sm tracking-tight text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface">
          <span>开始今日错题回顾</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h13.5m0 0-4.5-4.5M18 12l-4.5 4.5" />
          </svg>
        </button>
      </div>
    </div>

    <section class="rounded-lg border border-slate-100 bg-white px-6 py-6">
      <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Timeline</p>
      <h3 class="mt-2 text-lg font-medium tracking-tight text-slate-800">历史足迹</h3>

      <div class="mt-6 space-y-6">
        {recentActivities.map((activity) => (
          <div class="relative border-l border-slate-100 pl-8">
            <div class="absolute -left-[5px] top-1.5 h-2 w-2 rounded-full bg-brand-blue"></div>
            <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
              <div>
                <p class="text-[12px] tracking-tight text-slate-400">{activity.time}</p>
                <h5 class="mt-1 text-base font-medium tracking-tight text-slate-800">{activity.focus}</h5>
              </div>
              <div class="text-left md:text-right">
                <p class="text-sm font-medium tracking-tight text-slate-700">{activity.duration}</p>
                <p class="mt-1 text-[12px] tracking-tight text-slate-400">掌握度 {activity.mastery}%</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</ThreePaneLayout>
