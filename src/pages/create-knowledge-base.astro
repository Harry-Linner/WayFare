---
import '../styles/global.css';
import DetectedImportActionModal from '../components/common/DetectedImportActionModal.astro';
import KnowledgeBaseProcessingOverlay from '../components/demo/KnowledgeBaseProcessingOverlay.astro';
import { demoScenarios } from '../data/demoScenarios';

const retrievalScenario = demoScenarios['retrieval-practice'];

const PURPOSE_OPTIONS = [
  { value: 'exam-prep', label: '备考冲刺', icon: '📚', description: '围绕考试目标快速掌握重点内容' },
  { value: 'long-term', label: '长期学习', icon: '🌱', description: '持续积累，逐步建立完整知识体系' },
  { value: 'project-based', label: '项目实践', icon: '🛠️', description: '围绕具体项目整理资料与方法' },
  { value: 'research', label: '研究探索', icon: '🔬', description: '适合论文、专题阅读和深度思考' },
  { value: 'skill-building', label: '技能提升', icon: '🎯', description: '用于专项能力训练与表达提升' },
  { value: 'hobby', label: '兴趣拓展', icon: '✨', description: '把喜欢的内容沉淀为自己的知识库' }
];

const SUBJECT_OPTIONS = [
  { value: 'computer-science', label: '计算机科学', icon: '💻' },
  { value: 'mathematics', label: '数学', icon: '📐' },
  { value: 'physics', label: '物理', icon: '⚛️' },
  { value: 'chemistry', label: '化学', icon: '🧪' },
  { value: 'biology', label: '生物', icon: '🧬' },
  { value: 'economics', label: '经济学', icon: '📈' },
  { value: 'language', label: '语言文学', icon: '📝' },
  { value: 'history', label: '历史学', icon: '🏛️' },
  { value: 'other', label: '其他', icon: '📦' }
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>创建知识库 - WayFare</title>
  </head>
  <body class="bg-brand-cream min-h-screen">
    <nav class="bg-white shadow-sm border-b border-brand-blue/10 px-6 py-4">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/dashboard" class="w-8 h-8 bg-brand-blue rounded-lg flex items-center justify-center text-white font-bold hover:opacity-90 transition-all">
            W
          </a>
          <div>
            <h1 class="text-xl font-bold text-gray-800">创建知识库</h1>
            <p class="text-xs text-gray-500">设置你的学习空间</p>
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-4xl mx-auto px-6 py-8">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
        <div class="flex items-center justify-center mb-8">
          <div class="flex items-center space-x-4">
            <div id="step1-indicator" class="flex items-center space-x-2">
              <div class="w-8 h-8 bg-brand-blue text-white rounded-full flex items-center justify-center font-bold">1</div>
              <span class="text-sm font-medium text-gray-700">选择创建方式</span>
            </div>
            <div class="w-16 h-px bg-gray-300"></div>
            <div id="step2-indicator" class="flex items-center space-x-2 opacity-50">
              <div class="w-8 h-8 bg-gray-300 text-white rounded-full flex items-center justify-center font-bold">2</div>
              <span class="text-sm font-medium text-gray-500">填写信息</span>
            </div>
          </div>
        </div>

        <div id="step1-content" class="space-y-6">
          <h2 class="text-2xl font-bold text-gray-800 text-center mb-2">如何创建知识库？</h2>
          <p class="text-gray-600 text-center mb-8">选择最适合你的方式，把已有资料或新的学习主题整理成知识库。</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div id="import-option" class="border-2 border-gray-200 rounded-xl p-6 hover:border-brand-blue hover:shadow-lg transition-all cursor-pointer group">
              <div class="text-center space-y-4">
                <div class="w-16 h-16 bg-brand-blue/10 rounded-full flex items-center justify-center mx-auto group-hover:bg-brand-blue/20 transition-all">
                  <svg class="w-8 h-8 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-800">导入已有文件夹</h3>
                <p class="text-gray-600">选择本地文件夹作为知识库来源，系统将自动识别其中的学习资料。</p>
                <ul class="text-sm text-gray-500 space-y-1">
                  <li>• 自动读取资料文件</li>
                  <li>• 保留原有命名信息</li>
                  <li>• 适合快速建立知识库</li>
                </ul>
              </div>
            </div>

            <div id="create-option" class="border-2 border-gray-200 rounded-xl p-6 hover:border-brand-blue hover:shadow-lg transition-all cursor-pointer group">
              <div class="text-center space-y-4">
                <div class="w-16 h-16 bg-brand-blue/10 rounded-full flex items-center justify-center mx-auto group-hover:bg-brand-blue/20 transition-all">
                  <svg class="w-8 h-8 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-800">从零新建知识库</h3>
                <p class="text-gray-600">手动命名和设置知识库，之后再逐步添加学习资料。</p>
                <ul class="text-sm text-gray-500 space-y-1">
                  <li>• 适合长期主题学习</li>
                  <li>• 结构可持续扩展</li>
                  <li>• 更灵活地规划用途</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div id="step2-content" class="hidden space-y-6">
          <h2 class="text-2xl font-bold text-gray-800 text-center mb-2">完善知识库信息</h2>
          <p class="text-gray-600 text-center mb-8">告诉 WayFare 这个知识库将服务什么样的学习任务。</p>

          <form id="knowledge-base-form" class="space-y-6">
            <div>
              <label for="kb-name" class="block text-sm font-medium text-gray-700 mb-2">
                知识库名称<span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                id="kb-name" 
                name="name"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue transition-all"
                placeholder="给你的知识库起个名字"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-3">主要用途<span class="text-red-500">*</span></label>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                {PURPOSE_OPTIONS.map((option) => (
                  <label class="relative cursor-pointer group">
                    <input 
                      type="radio" 
                      name="purpose" 
                      value={option.value}
                      class="sr-only peer"
                      required
                    />
                    <div class="border-2 border-gray-200 rounded-lg p-4 peer-checked:border-brand-blue peer-checked:bg-brand-blue/5 peer-checked:shadow-md hover:border-brand-blue/50 transition-all">
                      <div class="flex items-center gap-3">
                        <span class="text-2xl">{option.icon}</span>
                        <div>
                          <div class="font-medium text-gray-800">{option.label}</div>
                          <div class="text-xs text-gray-500">{option.description}</div>
                        </div>
                      </div>
                    </div>
                  </label>
                ))}
              </div>
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">学科分类</label>
              <select 
                id="subject" 
                name="subject"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue transition-all"
              >
                <option value="">请选择学科分类（可选）</option>
                {SUBJECT_OPTIONS.map((option) => (
                  <option value={option.value}>{option.icon} {option.label}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="learning-goals" class="block text-sm font-medium text-gray-700 mb-2">学习目标</label>
              <textarea 
                id="learning-goals" 
                name="learningGoals"
                rows="3"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-blue focus:border-brand-blue transition-all resize-none"
                placeholder="例如：用于理解学习科学中的核心论文，并准备课程汇报..."
              ></textarea>
            </div>

            <div class="mb-6 pb-5">
              <label class="block text-sm font-medium text-gray-700 mb-3">预计学习周期</label>
              <div class="flex gap-4 flex-wrap">
                <label class="flex items-center">
                  <input type="radio" name="studyTime" value="short" class="mr-2 text-brand-blue focus:ring-brand-blue" />
                  <span class="text-sm text-gray-700">短期（1-4 周）</span>
                </label>
                <label class="flex items-center">
                  <input type="radio" name="studyTime" value="medium" class="mr-2 text-brand-blue focus:ring-brand-blue" />
                  <span class="text-sm text-gray-700">中期（1-3 个月）</span>
                </label>
                <label class="flex items-center">
                  <input type="radio" name="studyTime" value="long" class="mr-2 text-brand-blue focus:ring-brand-blue" />
                  <span class="text-sm text-gray-700">长期（3 个月以上）</span>
                </label>
              </div>
            </div>

            <div id="import-folder-info" class="hidden bg-blue-50 border border-blue-200 rounded-lg p-4">
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <p class="text-sm font-medium text-blue-800">已选择文件夹</p>
                  <p id="selected-folder-name" class="text-sm text-blue-600"></p>
                </div>
              </div>
            </div>
          </form>
        </div>

        <div class="flex justify-between pt-6 border-t border-gray-200">
          <button 
            id="back-btn" 
            class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition-all hidden"
            type="button"
          >
            上一步
          </button>
          <div></div>
          <div class="flex gap-3">
            <a 
              href="/dashboard" 
              class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-50 transition-all"
            >
              取消
            </a>
            <button 
              id="next-btn" 
              type="button"
              class="px-6 py-3 bg-brand-blue text-white rounded-lg font-medium hover:opacity-90 transition-all"
            >
              下一步
            </button>
            <button 
              id="create-btn" 
              type="button"
              class="px-6 py-3 bg-brand-blue text-white rounded-lg font-medium hover:opacity-90 transition-all hidden"
            >
              创建知识库
            </button>
          </div>
        </div>
      </div>
    </main>

    <input 
      type="file" 
      id="folder-input" 
      webkitdirectory="true" 
      directory="true" 
      multiple 
      class="hidden"
    />

    <DetectedImportActionModal scenario={retrievalScenario} />
    <KnowledgeBaseProcessingOverlay scenario={retrievalScenario} />

    <script>
      import { addKnowledgeBase, updateKnowledgeBaseDocumentCount } from '../store/learningStore';
      import { addDocumentEntriesToKnowledgeBase } from '../store/documentStore';
      import { getDemoScenarioByFileNames } from '../data/demoScenarios';

      let currentStep = 1;
      let creationMethod = '';
      let selectedFolderName = '';
      let importedFiles: File[] = [];
      let pendingKnowledgeBaseData: any = null;
      let pendingScenario: ReturnType<typeof getDemoScenarioByFileNames> | null = null;

      const step1Content = document.getElementById('step1-content');
      const step2Content = document.getElementById('step2-content');
      const step1Indicator = document.getElementById('step1-indicator');
      const step2Indicator = document.getElementById('step2-indicator');
      const nextBtn = document.getElementById('next-btn');
      const backBtn = document.getElementById('back-btn');
      const createBtn = document.getElementById('create-btn');
      const importOption = document.getElementById('import-option');
      const createOption = document.getElementById('create-option');
      const folderInput = document.getElementById('folder-input') as HTMLInputElement | null;
      const importFolderInfo = document.getElementById('import-folder-info');
      const selectedFolderNameEl = document.getElementById('selected-folder-name');
      const form = document.getElementById('knowledge-base-form') as HTMLFormElement | null;
      const detectedImportModal = document.getElementById('detected-import-action-modal') as HTMLDialogElement | null;
      const processingOverlay = document.getElementById('demo-processing-overlay');
      const processingProgressLabel = document.getElementById('demo-processing-progress-label');
      const processingProgressBar = document.getElementById('demo-processing-progress-bar') as HTMLElement | null;
      const processingStepElements = Array.from(document.querySelectorAll<HTMLElement>('.demo-processing-step'));

      function showStep(step: number) {
        currentStep = step;

        if (step === 1) {
          step1Content?.classList.remove('hidden');
          step2Content?.classList.add('hidden');
          step1Indicator?.classList.remove('opacity-50');
          step2Indicator?.classList.add('opacity-50');
          backBtn?.classList.add('hidden');
          nextBtn?.classList.remove('hidden');
          createBtn?.classList.add('hidden');
        } else {
          step1Content?.classList.add('hidden');
          step2Content?.classList.remove('hidden');
          step1Indicator?.classList.add('opacity-50');
          step2Indicator?.classList.remove('opacity-50');
          backBtn?.classList.remove('hidden');
          nextBtn?.classList.add('hidden');
          createBtn?.classList.remove('hidden');
        }
      }

      function getRandomColor(): string {
        const colors = [
          'bg-brand-blue',
          'bg-priority-important',
          'bg-priority-critical',
          'bg-green-500',
          'bg-purple-500',
          'bg-yellow-500',
          'bg-pink-500',
          'bg-indigo-500'
        ];
        return colors[Math.floor(Math.random() * colors.length)];
      }

      function getRandomIcon(): string {
        const icons = ['📘', '🌱', '💻', '🌐', '🧠', '📝', '🎯', '🔬'];
        return icons[Math.floor(Math.random() * icons.length)];
      }

      function buildKnowledgeBaseData() {
        if (!form) {
          return null;
        }

        const formData = new FormData(form);
        const sourceDocumentCount = creationMethod === 'import' ? importedFiles.length : 0;
        return {
          name: formData.get('name') as string,
          description: (formData.get('learningGoals') as string) || '暂无描述',
          progress: 0,
          documentCount: sourceDocumentCount,
          color: getRandomColor(),
          icon: getRandomIcon(),
          purpose: formData.get('purpose') as string,
          subject: (formData.get('subject') as string) || undefined,
          learningGoals: (formData.get('learningGoals') as string) || undefined,
          studyTime: (formData.get('studyTime') as 'short' | 'medium' | 'long') || undefined,
          creationMethod: creationMethod as 'import' | 'create',
          folderName: selectedFolderName || undefined
        };
      }

      function seedImportedDocuments(kbId: string, processingLabel: string) {
        if (importedFiles.length === 0) {
          return;
        }

        addDocumentEntriesToKnowledgeBase(
          kbId,
          importedFiles.map((file) => ({
            name: file.name,
            size: file.size,
            type: file.type || 'text/markdown',
            processingMode: 'nothing',
            processingLabel,
            kind: 'source'
          }))
        );
      }

      function seedGeneratedDemoAsset(kbId: string, label: string, generatedType: 'annotated-view' | 'study-brief') {
        addDocumentEntriesToKnowledgeBase(kbId, [
          {
            name: generatedType === 'annotated-view' ? '分层批注视图' : '汇报与复习重点',
            size: 0,
            type: 'application/x-wayfare-demo',
            processingMode: generatedType === 'annotated-view' ? 'annotate' : 'summary',
            processingLabel: label,
            kind: 'generated',
            generatedType
          }
        ]);
      }

      async function finalizeCreate(kbData: any, demoConfig?: { scenarioId?: string; processingMode?: string; processingLabel?: string; demoStatus?: 'completed' | 'idle' }) {
        const newKb = addKnowledgeBase({
          ...kbData,
          demoScenarioId: demoConfig?.scenarioId,
          demoProcessingMode: demoConfig?.processingMode as any,
          demoProcessingLabel: demoConfig?.processingLabel,
          demoStatus: demoConfig?.demoStatus
        });

        let sourceDocumentCount = 0;

        if (creationMethod === 'import') {
          seedImportedDocuments(newKb.id, '原始资料');
          sourceDocumentCount += importedFiles.length;
        }

        if (demoConfig?.scenarioId === 'retrieval-practice') {
          if (demoConfig.processingMode === 'layered-annotation' || demoConfig.processingMode === 'custom') {
            seedGeneratedDemoAsset(newKb.id, demoConfig.processingLabel || '已生成分层批注', 'annotated-view');
          }
          if (demoConfig.processingMode === 'study-brief') {
            seedGeneratedDemoAsset(newKb.id, demoConfig.processingLabel || '已提炼汇报与复习重点', 'study-brief');
          }
        }

        if (sourceDocumentCount > 0) {
          updateKnowledgeBaseDocumentCount(newKb.id, sourceDocumentCount);
        }

        window.location.href = `/dashboard?highlight=${encodeURIComponent(newKb.id)}`;
      }

      async function runProcessingEffectAndCreate(processingMode: string, processingLabel: string) {
        processingOverlay?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        processingStepElements.forEach((stepEl, index) => {
          const indicator = stepEl.querySelector<HTMLElement>('.step-indicator');
          const status = stepEl.querySelector<HTMLElement>('.step-status');
          stepEl.classList.remove('ring-2', 'ring-brand-blue/20', 'bg-brand-blue/5');
          indicator?.classList.remove('bg-brand-blue', 'text-white', 'border-brand-blue', 'bg-green-500', 'border-green-500');
          indicator?.classList.add('bg-white', 'text-gray-400', 'border-gray-200');
          if (status) status.textContent = '等待中';
        });

        for (let i = 0; i < processingStepElements.length; i++) {
          const stepEl = processingStepElements[i];
          const indicator = stepEl.querySelector<HTMLElement>('.step-indicator');
          const status = stepEl.querySelector<HTMLElement>('.step-status');
          const progress = Math.round(((i + 1) / processingStepElements.length) * 100);

          stepEl.classList.add('ring-2', 'ring-brand-blue/20', 'bg-brand-blue/5');
          indicator?.classList.remove('bg-white', 'text-gray-400', 'border-gray-200');
          indicator?.classList.add('bg-brand-blue', 'text-white', 'border-brand-blue');
          if (status) status.textContent = '处理中';
          if (processingProgressLabel) processingProgressLabel.textContent = `${progress}%`;
          if (processingProgressBar) processingProgressBar.style.width = `${progress}%`;

          await new Promise((resolve) => setTimeout(resolve, 800));

          stepEl.classList.remove('ring-2', 'ring-brand-blue/20');
          stepEl.classList.add('bg-green-50');
          indicator?.classList.remove('bg-brand-blue', 'border-brand-blue');
          indicator?.classList.add('bg-green-500', 'border-green-500');
          if (status) status.textContent = '已完成';
        }

        await new Promise((resolve) => setTimeout(resolve, 500));
        document.body.style.overflow = '';

        await finalizeCreate(pendingKnowledgeBaseData, {
          scenarioId: pendingScenario?.id,
          processingMode,
          processingLabel,
          demoStatus: processingMode === 'raw-only' ? 'idle' : 'completed'
        });
      }

      importOption?.addEventListener('click', () => {
        creationMethod = 'import';
        folderInput?.click();
      });

      createOption?.addEventListener('click', () => {
        creationMethod = 'create';
        showStep(2);
      });

      folderInput?.addEventListener('change', (event) => {
        const files = Array.from((event.target as HTMLInputElement).files ?? []);
        importedFiles = files;

        if (files.length > 0) {
          const path = files[0].webkitRelativePath;
          const folderName = path.split('/')[0];
          selectedFolderName = folderName;
          if (selectedFolderNameEl) selectedFolderNameEl.textContent = folderName;
          importFolderInfo?.classList.remove('hidden');

          const nameInput = document.getElementById('kb-name') as HTMLInputElement | null;
          if (nameInput) {
            nameInput.value = folderName;
          }

          showStep(2);
        }
      });

      backBtn?.addEventListener('click', () => {
        if (currentStep === 2) {
          showStep(1);
        }
      });

      nextBtn?.addEventListener('click', () => {
        if (creationMethod) {
          showStep(2);
        }
      });

      createBtn?.addEventListener('click', async () => {
        if (!form?.checkValidity()) {
          form?.reportValidity();
          return;
        }

        const kbData = buildKnowledgeBaseData();
        if (!kbData) return;

        pendingKnowledgeBaseData = kbData;
        pendingScenario = creationMethod === 'import'
          ? getDemoScenarioByFileNames(importedFiles.map((file) => file.name))
          : null;

        if (pendingScenario && creationMethod === 'import') {
          detectedImportModal?.showModal();
          return;
        }

        await finalizeCreate(kbData, {
          demoStatus: 'idle'
        });
      });

      window.addEventListener('demo:import-option-selected', ((event: CustomEvent<{ processingMode: string; processingLabel: string }>) => {
        const { processingMode, processingLabel } = event.detail;
        if (!pendingKnowledgeBaseData) {
          return;
        }

        if (processingMode === 'raw-only') {
          finalizeCreate(pendingKnowledgeBaseData, {
            demoStatus: 'idle'
          });
          return;
        }

        runProcessingEffectAndCreate(processingMode, processingLabel);
      }) as EventListener);

      const nameInput = document.getElementById('kb-name') as HTMLInputElement | null;
      nameInput?.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.value.trim().length < 2) {
          target.setCustomValidity('知识库名称至少需要 2 个字符');
        } else {
          target.setCustomValidity('');
        }
      });
    </script>
  </body>
</html>
