---
import '../styles/global.css';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>创建知识库</title>
  </head>
  <body class="min-h-screen bg-brand-cream text-slate-700">
    <nav class="border-b border-slate-100 bg-white/88 backdrop-blur-sm">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <div class="flex items-center gap-4">
          <a href="/dashboard" class="flex h-10 w-10 items-center justify-center rounded-md border border-slate-100 bg-brand-surface/40 text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface/70" title="返回仪表盘">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
          </a>
          <div>
            <p class="text-[11px] uppercase tracking-[0.24em] text-slate-400">Create Library</p>
            <h1 class="mt-1 text-base font-medium tracking-tight text-slate-800">创建知识库</h1>
          </div>
        </div>
      </div>
    </nav>

    <main class="mx-auto max-w-5xl px-6 py-10">
      <div class="rounded-lg border border-slate-100 bg-white px-6 py-8 md:px-10 md:py-10">
        <div class="border-b border-slate-100 pb-8">
          <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
            <div class="max-w-2xl">
              <p class="text-[11px] uppercase tracking-[0.24em] text-slate-400">New Knowledge Base</p>
              <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-800">为你的学习材料建立一个安静的入口</h2>
              <p class="mt-4 text-base leading-8 text-slate-500">你可以导入现有资料，也可以从空白项目开始。界面尽量保持轻量，让整理过程像在纸面上做一份清晰的目录。</p>
            </div>
            <div class="flex items-center gap-5">
              <div id="step1-indicator" class="flex items-center gap-3">
                <span class="flex h-8 w-8 items-center justify-center rounded-full border border-brand-blue/40 bg-brand-surface/60 text-sm font-medium text-slate-700">1</span>
                <span class="text-sm tracking-tight text-slate-700">创建方式</span>
              </div>
              <div class="h-px w-10 bg-slate-100"></div>
              <div id="step2-indicator" class="flex items-center gap-3 opacity-40">
                <span class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 bg-white text-sm font-medium text-slate-500">2</span>
                <span class="text-sm tracking-tight text-slate-500">填写信息</span>
              </div>
            </div>
          </div>
        </div>

        <section id="step1-content" class="pt-8">
          <div class="mb-8">
            <h3 class="text-xl font-medium tracking-tight text-slate-800">先选择一个开始方式</h3>
            <p class="mt-2 text-sm leading-7 text-slate-500">不同方式只影响初始组织形式，不会限制你后续继续调整。</p>
          </div>
          <div class="grid gap-5 md:grid-cols-2">
            <button id="import-option" type="button" class="group rounded-lg border border-slate-100 bg-white px-6 py-6 text-left transition hover:border-brand-blue/40 hover:bg-brand-surface/25">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Import</p>
                  <h4 class="mt-3 text-lg font-medium tracking-tight text-slate-800">导入现有文件夹</h4>
                </div>
                <span class="flex h-9 w-9 items-center justify-center rounded-md border border-slate-100 bg-brand-surface/35 text-slate-500 transition group-hover:border-brand-blue/40">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V4.5m0 0-4.5 4.5M12 4.5l4.5 4.5M4.5 19.5h15" />
                  </svg>
                </span>
              </div>
              <p class="mt-4 text-sm leading-7 text-slate-500">保留你原有的资料目录，并自动将其中的 PDF 文件纳入知识库。</p>
            </button>
            <button id="create-option" type="button" class="group rounded-lg border border-slate-100 bg-white px-6 py-6 text-left transition hover:border-brand-blue/40 hover:bg-brand-surface/25">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Blank</p>
                  <h4 class="mt-3 text-lg font-medium tracking-tight text-slate-800">创建空白知识库</h4>
                </div>
                <span class="flex h-9 w-9 items-center justify-center rounded-md border border-slate-100 bg-brand-surface/35 text-slate-500 transition group-hover:border-brand-blue/40">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
                  </svg>
                </span>
              </div>
              <p class="mt-4 text-sm leading-7 text-slate-500">从零开始搭建一个新的学习空间，后续再按需补充文档。</p>
            </button>
          </div>
        </section>

        <section id="step2-content" class="hidden pt-8">
          <div class="mb-8">
            <h3 class="text-xl font-medium tracking-tight text-slate-800">补充知识库信息</h3>
            <p class="mt-2 text-sm leading-7 text-slate-500">这些信息会帮助系统理解你的学习场景，但整体仍然保持轻量。</p>
          </div>
          <form id="knowledge-base-form" class="space-y-8">
            <div class="grid gap-8 md:grid-cols-[1.2fr_0.8fr]">
              <div class="space-y-6">
                <div>
                  <label for="kb-name" class="mb-2 block text-sm font-medium tracking-tight text-slate-700">知识库名称 <span class="text-[#B98839]">*</span></label>
                  <input type="text" id="kb-name" name="name" required placeholder="例如：操作系统期末复习 / 论文阅读归档" class="w-full rounded-md border border-slate-100 bg-white px-4 py-3 text-sm tracking-tight text-slate-700 placeholder:text-slate-400 outline-none transition focus:border-brand-blue/40" />
                  <p class="mt-2 text-xs leading-6 text-slate-400">名称用于首页和工作区展示，建议简洁明确。</p>
                </div>
                <div>
                  <label for="subject" class="mb-2 block text-sm font-medium tracking-tight text-slate-700">学科分类</label>
                  <select id="subject" name="subject" class="w-full rounded-md border border-slate-100 bg-white px-4 py-3 text-sm tracking-tight text-slate-700 outline-none transition focus:border-brand-blue/40">
                    <option value="">请选择学科（可选）</option>
                    <option value="computer-science">计算机科学</option>
                    <option value="mathematics">数学</option>
                    <option value="physics">物理</option>
                    <option value="chemistry">化学</option>
                    <option value="biology">生物</option>
                    <option value="economics">经济学</option>
                    <option value="language">语言文学</option>
                    <option value="history">历史</option>
                    <option value="other">其他</option>
                  </select>
                </div>
                <div>
                  <label for="learning-goals" class="mb-2 block text-sm font-medium tracking-tight text-slate-700">学习目标</label>
                  <textarea id="learning-goals" name="learningGoals" rows="4" placeholder="例如：理清 AVL 树的旋转逻辑，并把高频考点提炼出来。" class="w-full resize-none rounded-md border border-slate-100 bg-white px-4 py-3 text-sm leading-7 tracking-tight text-slate-700 placeholder:text-slate-400 outline-none transition focus:border-brand-blue/40"></textarea>
                </div>
                <div>
                  <p class="mb-3 text-sm font-medium tracking-tight text-slate-700">预计周期</p>
                  <div class="space-y-2">
                    <label class="flex cursor-pointer items-center gap-3 rounded-md border border-slate-100 bg-white px-4 py-3 transition hover:border-brand-blue/30"><input type="radio" name="studyTime" value="short" class="text-brand-blue focus:ring-brand-blue" /><span class="text-sm tracking-tight text-slate-600">短期 · 1–4 周</span></label>
                    <label class="flex cursor-pointer items-center gap-3 rounded-md border border-slate-100 bg-white px-4 py-3 transition hover:border-brand-blue/30"><input type="radio" name="studyTime" value="medium" class="text-brand-blue focus:ring-brand-blue" /><span class="text-sm tracking-tight text-slate-600">中期 · 1–3 个月</span></label>
                    <label class="flex cursor-pointer items-center gap-3 rounded-md border border-slate-100 bg-white px-4 py-3 transition hover:border-brand-blue/30"><input type="radio" name="studyTime" value="long" class="text-brand-blue focus:ring-brand-blue" /><span class="text-sm tracking-tight text-slate-600">长期 · 3 个月以上</span></label>
                  </div>
                </div>
              </div>
              <div class="space-y-6">
                <div>
                  <p class="mb-3 text-sm font-medium tracking-tight text-slate-700">主要用途 <span class="text-[#B98839]">*</span></p>
                  <div class="space-y-2">
                    <label class="block cursor-pointer"><input type="radio" name="purpose" value="exam-prep" class="peer sr-only" required /><div class="rounded-md border border-slate-100 bg-white px-4 py-4 transition peer-checked:border-brand-blue/40 peer-checked:bg-brand-surface/25 hover:border-brand-blue/30"><div class="text-sm font-medium tracking-tight text-slate-700">考试准备</div><div class="mt-1 text-xs leading-6 text-slate-500">更强调重点归纳、考点识别与短期复习。</div></div></label>
                    <label class="block cursor-pointer"><input type="radio" name="purpose" value="long-term" class="peer sr-only" required /><div class="rounded-md border border-slate-100 bg-white px-4 py-4 transition peer-checked:border-brand-blue/40 peer-checked:bg-brand-surface/25 hover:border-brand-blue/30"><div class="text-sm font-medium tracking-tight text-slate-700">长期学习</div><div class="mt-1 text-xs leading-6 text-slate-500">适合系统化积累知识，保留完整上下文。</div></div></label>
                    <label class="block cursor-pointer"><input type="radio" name="purpose" value="project-based" class="peer sr-only" required /><div class="rounded-md border border-slate-100 bg-white px-4 py-4 transition peer-checked:border-brand-blue/40 peer-checked:bg-brand-surface/25 hover:border-brand-blue/30"><div class="text-sm font-medium tracking-tight text-slate-700">项目实践</div><div class="mt-1 text-xs leading-6 text-slate-500">围绕具体任务或项目组织学习材料。</div></div></label>
                    <label class="block cursor-pointer"><input type="radio" name="purpose" value="research" class="peer sr-only" required /><div class="rounded-md border border-slate-100 bg-white px-4 py-4 transition peer-checked:border-brand-blue/40 peer-checked:bg-brand-surface/25 hover:border-brand-blue/30"><div class="text-sm font-medium tracking-tight text-slate-700">研究探索</div><div class="mt-1 text-xs leading-6 text-slate-500">更偏向论文、资料与问题链式阅读。</div></div></label>
                  </div>
                </div>
                <div id="import-folder-info" class="hidden rounded-md border border-slate-100 bg-brand-surface/25 px-4 py-4">
                  <p class="text-[11px] uppercase tracking-[0.22em] text-slate-400">Selected Folder</p>
                  <p id="selected-folder-name" class="mt-2 text-sm tracking-tight text-slate-700"></p>
                </div>
              </div>
            </div>
          </form>
        </section>

        <div class="mt-10 flex items-center justify-between border-t border-slate-100 pt-6">
          <button id="back-btn" type="button" class="hidden rounded-md border border-slate-100 bg-white px-4 py-2 text-sm tracking-tight text-slate-600 transition hover:border-slate-200 hover:bg-slate-50 hover:text-slate-700">上一步</button>
          <div id="back-btn-placeholder" class="h-10"></div>
          <div class="flex items-center gap-3">
            <a href="/dashboard" id="cancel-link" class="rounded-md border border-slate-100 bg-white px-4 py-2 text-sm tracking-tight text-slate-500 transition hover:border-slate-200 hover:bg-slate-50 hover:text-slate-700">取消</a>
            <button id="next-btn" type="button" class="rounded-md border border-slate-100 bg-brand-surface/55 px-4 py-2 text-sm tracking-tight text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface">下一步</button>
            <button id="create-btn" type="button" class="hidden rounded-md border border-slate-100 bg-brand-surface/35 px-4 py-2 text-sm tracking-tight text-slate-400 transition disabled:cursor-not-allowed disabled:opacity-100" disabled>创建知识库</button>
          </div>
        </div>
        <p id="create-hint" class="mt-3 text-right text-xs tracking-tight text-slate-400"></p>
      </div>
    </main>

    <input type="file" id="folder-input" webkitdirectory="true" directory="true" multiple class="hidden" />

    <script>
      import { uploadFile } from '../lib/api';
      let currentStep = 1;
      let creationMethod = '';
      let selectedFolderName = '';
      let selectedFolderFiles = [];

      const step1Content = document.getElementById('step1-content');
      const step2Content = document.getElementById('step2-content');
      const step1Indicator = document.getElementById('step1-indicator');
      const step2Indicator = document.getElementById('step2-indicator');
      const nextBtn = document.getElementById('next-btn');
      const backBtn = document.getElementById('back-btn');
      const backBtnPlaceholder = document.getElementById('back-btn-placeholder');
      const createBtn = document.getElementById('create-btn');
      const importOption = document.getElementById('import-option');
      const createOption = document.getElementById('create-option');
      const folderInput = document.getElementById('folder-input');
      const importFolderInfo = document.getElementById('import-folder-info');
      const selectedFolderNameEl = document.getElementById('selected-folder-name');
      const form = document.getElementById('knowledge-base-form');
      const cancelLink = document.getElementById('cancel-link');
      const createHint = document.getElementById('create-hint');

      function setIndicatorState(active) {
        const span = active.querySelector('span:last-child');
        active.classList.remove('opacity-40');
        active.querySelector('span:first-child')?.classList.add('border-brand-blue/40', 'bg-brand-surface/60', 'text-slate-700');
        active.querySelector('span:first-child')?.classList.remove('border-slate-200', 'bg-white', 'text-slate-500');
        span?.classList.add('text-slate-700');
        span?.classList.remove('text-slate-500');
      }

      function setIndicatorInactive(node) {
        const span = node.querySelector('span:last-child');
        node.classList.add('opacity-40');
        node.querySelector('span:first-child')?.classList.remove('border-brand-blue/40', 'bg-brand-surface/60', 'text-slate-700');
        node.querySelector('span:first-child')?.classList.add('border-slate-200', 'bg-white', 'text-slate-500');
        span?.classList.remove('text-slate-700');
        span?.classList.add('text-slate-500');
      }

      function showStep(step) {
        currentStep = step;
        if (step === 1) {
          step1Content?.classList.remove('hidden');
          step2Content?.classList.add('hidden');
          backBtn?.classList.add('hidden');
          backBtnPlaceholder?.classList.remove('hidden');
          nextBtn?.classList.remove('hidden');
          createBtn?.classList.add('hidden');
          cancelLink?.setAttribute('href', `/dashboard?refresh=${Date.now()}`);
          setIndicatorState(step1Indicator);
          setIndicatorInactive(step2Indicator);
        } else {
          step1Content?.classList.add('hidden');
          step2Content?.classList.remove('hidden');
          backBtn?.classList.remove('hidden');
          backBtnPlaceholder?.classList.add('hidden');
          nextBtn?.classList.add('hidden');
          createBtn?.classList.remove('hidden');
          cancelLink?.setAttribute('href', '/dashboard');
          setIndicatorInactive(step1Indicator);
          setIndicatorState(step2Indicator);
        }
      }

      function updateCreateButtonState() {
        if (!createBtn || !form || !createHint) return;
        const missingFields = [];
        const nameValue = form.querySelector('#kb-name')?.value?.trim();
        const purposeValue = form.querySelector('input[name="purpose"]:checked')?.value;

        if (!creationMethod) {
          createBtn.disabled = true;
          createBtn.className = `${currentStep === 1 ? 'hidden ' : ''}rounded-md border border-slate-100 bg-brand-surface/35 px-4 py-2 text-sm tracking-tight text-slate-400 transition disabled:cursor-not-allowed disabled:opacity-100`;
          createHint.textContent = '请先确定创建方式';
          return;
        }
        if (!nameValue) missingFields.push('知识库名称');
        if (!purposeValue) missingFields.push('主要用途');
        if (creationMethod === 'import') {
          const pdfCount = selectedFolderFiles.filter((file) => /\.pdf$/i.test(file.name)).length;
          if (pdfCount === 0) missingFields.push('至少导入一个 PDF 文件');
        }
        const isReady = missingFields.length === 0;
        createBtn.disabled = !isReady;
        createBtn.className = `${currentStep === 1 ? 'hidden ' : ''}${isReady ? 'rounded-md border border-brand-blue/70 bg-brand-blue px-4 py-2 text-sm tracking-tight text-slate-800 transition hover:opacity-95' : 'rounded-md border border-slate-100 bg-brand-surface/35 px-4 py-2 text-sm tracking-tight text-slate-400 transition disabled:cursor-not-allowed disabled:opacity-100'}`;
        createHint.textContent = isReady ? '必填项已完成，现在可以创建知识库' : `请先完成：${missingFields.join('、')}`;
      }

      importOption?.addEventListener('click', () => {
        creationMethod = 'import';
        folderInput?.click();
      });

      createOption?.addEventListener('click', () => {
        creationMethod = 'create';
        selectedFolderName = '';
        selectedFolderFiles = [];
        importFolderInfo?.classList.add('hidden');
        showStep(2);
        updateCreateButtonState();
      });

      folderInput?.addEventListener('change', (event) => {
        const files = Array.from(event.target.files || []);
        if (!files.length) return;
        selectedFolderFiles = files;
        const firstPath = files[0].webkitRelativePath || files[0].name;
        const folderName = firstPath.split('/')[0];
        const pdfCount = files.filter((file) => /\.pdf$/i.test(file.name)).length;
        creationMethod = 'import';
        selectedFolderName = folderName;
        if (selectedFolderNameEl) selectedFolderNameEl.textContent = `${folderName} （${pdfCount} 个 PDF）`;
        const nameInput = document.getElementById('kb-name');
        if (nameInput && !nameInput.value) nameInput.value = folderName;
        importFolderInfo?.classList.remove('hidden');
        showStep(2);
        updateCreateButtonState();
      });

      nextBtn?.addEventListener('click', () => {
        if (!creationMethod) {
          alert('请先选择一种创建方式');
          return;
        }
        showStep(2);
        updateCreateButtonState();
      });

      backBtn?.addEventListener('click', () => {
        showStep(1);
        updateCreateButtonState();
      });

      createBtn?.addEventListener('click', async () => {
        if (!form || !form.checkValidity()) {
          form?.reportValidity();
          return;
        }
        try {
          const formData = new FormData(form);
          const { addKnowledgeBase, knowledgeBases } = await import('../store/learningStore');
          const kbData = {
            name: formData.get('name'),
            description: formData.get('learningGoals') || '暂无描述',
            progress: 0,
            lastAccessed: new Date().toISOString(),
            documentCount: 0,
            color: getRandomColor(),
            icon: getRandomIcon(),
            purpose: formData.get('purpose'),
            subject: formData.get('subject') || undefined,
            learningGoals: formData.get('learningGoals') || undefined,
            studyTime: formData.get('studyTime') || undefined,
            creationMethod: creationMethod || 'create',
            folderName: selectedFolderName || undefined,
            createdAt: new Date().toISOString()
          };
          const newKb = addKnowledgeBase(kbData);
          const updatedKbs = knowledgeBases.get();
          if (creationMethod === 'import') {
            const pdfFiles = selectedFolderFiles.filter((file) => /\.pdf$/i.test(file.name));
            for (let i = 0; i < pdfFiles.length; i++) {
              const file = pdfFiles[i];
              createHint.textContent = `正在导入 PDF（${i + 1}/${pdfFiles.length}）`;
              await uploadFile(file, newKb.id, file.webkitRelativePath || file.name);
            }
          }
          window.dispatchEvent(new CustomEvent('knowledgebase:added', { detail: { knowledgeBase: newKb, allKnowledgeBases: updatedKbs } }));
          alert('知识库创建成功');
          setTimeout(() => {
            window.location.href = creationMethod === 'import' ? `/workspace/${newKb.id}` : `/dashboard?refresh=${Date.now()}`;
          }, 250);
        } catch (error) {
          console.error('创建知识库失败', error);
          alert('创建失败，请稍后重试');
          updateCreateButtonState();
        }
      });

      form?.addEventListener('input', updateCreateButtonState);
      form?.addEventListener('change', updateCreateButtonState);

      function getRandomColor() {
        const colors = ['bg-brand-blue','bg-priority-important','bg-priority-critical','bg-green-500','bg-purple-500','bg-yellow-500','bg-pink-500','bg-indigo-500'];
        return colors[Math.floor(Math.random() * colors.length)];
      }
      function getRandomIcon() {
        const icons = ['文','读','研','笔','案','课'];
        return icons[Math.floor(Math.random() * icons.length)];
      }

      showStep(1);
      updateCreateButtonState();
    </script>
  </body>
</html>
