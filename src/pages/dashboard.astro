---
import AIAssistant from '../components/ai/AIAssistant.astro';
import AIToggleButton from '../components/ai/AIToggleButton.astro';
import BetaLogoutButton from '../components/auth/BetaLogoutButton.astro';
import FeedbackWidget from '../components/feedback/FeedbackWidget.astro';
import ProfileEditorPanel from '../components/profile/ProfileEditorPanel.astro';
import '../styles/global.css';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WayFare · 知识库总览</title>
  </head>
  <body class="min-h-screen bg-brand-cream text-slate-700">
    <div class="min-h-screen">
      <nav class="border-b border-slate-100 bg-white/88 backdrop-blur-sm">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
          <div class="flex items-center gap-4">
            <a
              href="/dashboard"
              class="flex h-10 w-10 items-center justify-center rounded-md border border-slate-100 bg-brand-surface/40 text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface/70"
              title="返回知识库首页"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.75 12 3l8.25 6.75V20.25H3.75z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 20.25v-6h6v6" />
              </svg>
            </a>
            <div>
              <p class="text-[11px] uppercase tracking-[0.24em] text-slate-400">WayFare</p>
              <h1 class="mt-1 text-base font-medium tracking-tight text-slate-800">知识库总览</h1>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <BetaLogoutButton next="/login" />
            <a
              href="/workspace/schedule"
              class="inline-flex items-center gap-2 rounded-md border border-slate-100 bg-white px-4 py-2 text-sm tracking-tight text-slate-600 transition hover:border-brand-blue/40 hover:bg-brand-surface/35 hover:text-slate-700"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12m-12 5.25h12m-12 5.25h12" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h.008v.008H3.75zm0 5.25h.008v.008H3.75zm0 5.25h.008v.008H3.75z" />
              </svg>
              <span>主动式日程板</span>
            </a>
            <a
              href="/create-knowledge-base"
              class="inline-flex items-center gap-2 rounded-md border border-slate-100 bg-brand-surface/55 px-4 py-2 text-sm tracking-tight text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
              </svg>
              <span>新建知识库</span>
            </a>
            <div class="flex h-9 w-9 items-center justify-center rounded-md border border-slate-100 bg-white text-[11px] font-medium uppercase tracking-[0.18em] text-slate-500">
              WF
            </div>
          </div>
        </div>
      </nav>

      <main class="mx-auto max-w-6xl px-6 py-10">
        <section class="border-b border-slate-100 pb-8">
          <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-2xl">
              <p class="text-[11px] uppercase tracking-[0.24em] text-slate-400">知识库总览</p>
              <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-800">我的知识库</h2>
              <p class="mt-4 text-base leading-8 text-slate-500">
                这里展示当前所有知识库、文档状态和整体就绪情况。优先目标仍然是让“创建 → 上传 → 解析 → 阅读 → AI 提问 → 反馈”这条链路稳定可用。
              </p>
            </div>

            <div id="stats-grid" class="grid grid-cols-2 gap-x-8 gap-y-5 lg:grid-cols-4">
              <div class="border-t border-slate-100 pt-4">
                <p class="text-[11px] uppercase tracking-[0.2em] text-slate-400">知识库数量</p>
                <div id="stat-kb-count" class="mt-2 text-xl font-medium tracking-tight text-slate-800">0</div>
              </div>
              <div class="border-t border-slate-100 pt-4">
                <p class="text-[11px] uppercase tracking-[0.2em] text-slate-400">文档总数</p>
                <div id="stat-doc-count" class="mt-2 text-xl font-medium tracking-tight text-slate-800">0</div>
              </div>
              <div class="border-t border-slate-100 pt-4">
                <p class="text-[11px] uppercase tracking-[0.2em] text-slate-400">解析中</p>
                <div id="stat-processing-count" class="mt-2 text-xl font-medium tracking-tight text-slate-800">0</div>
              </div>
              <div class="border-t border-slate-100 pt-4">
                <p class="text-[11px] uppercase tracking-[0.2em] text-slate-400">就绪率</p>
                <div id="stat-ready-rate" class="mt-2 text-xl font-medium tracking-tight text-slate-800">0%</div>
              </div>
            </div>
          </div>
        </section>

        <section class="flex flex-col gap-4 border-b border-slate-100 py-6 md:flex-row md:items-center md:justify-between">
          <div class="flex items-center gap-3">
            <a
              href="/create-knowledge-base"
              class="inline-flex items-center gap-2 rounded-md border border-slate-100 bg-white px-4 py-2 text-sm tracking-tight text-slate-600 transition hover:border-slate-200 hover:bg-slate-50 hover:text-slate-700"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
              </svg>
              继续添加
            </a>
            <button
              id="refresh-knowledge-bases"
              type="button"
              class="rounded-md border border-slate-100 bg-white px-3 py-2 text-sm tracking-tight text-slate-500 transition hover:border-slate-200 hover:bg-slate-50 hover:text-slate-700"
            >
              刷新
            </button>
          </div>

          <div class="flex items-center gap-2">
            <select
              id="sort-select"
              class="rounded-md border border-slate-100 bg-white px-3 py-2 text-sm tracking-tight text-slate-500 focus:border-brand-blue/40 focus:outline-none"
            >
              <option value="recent">最近更新</option>
              <option value="documents">按文档数量</option>
              <option value="progress">按就绪率</option>
            </select>
          </div>
        </section>

        <div id="dashboard-feedback" class="hidden mt-6 rounded-md border px-4 py-3 text-sm leading-7"></div>

        <section class="mt-8 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
          <ProfileEditorPanel
            scope="global"
            title="全局学习画像"
            description="把长期目标、解释风格、语言偏好和 AI 角色要求写成 Markdown，后续回答会自动读取这里。"
            onboardingHref="/onboarding"
          />
          <FeedbackWidget
            defaultPage="dashboard"
            defaultScope="dashboard"
            title="网页版内测反馈"
            description="如果仪表盘统计、知识库列表或 AI 总览有问题，直接在这里提交。"
            buttonLabel="反馈问题"
          />
        </section>

        <section class="pt-8">
          <div id="knowledge-base-grid" class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3"></div>

          <div id="knowledge-base-empty" class="hidden py-20 text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-md border border-slate-100 bg-white text-slate-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 4.5h6l4.5 4.5V19.5H7.5z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5v4.5H18" />
              </svg>
            </div>
            <h3 class="mt-5 text-lg font-medium tracking-tight text-slate-700">还没有知识库</h3>
            <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-slate-500">
              先创建一个知识库，再进入文档上传、解析和 AI 阅读链路。
            </p>
            <a
              href="/create-knowledge-base"
              class="mt-6 inline-flex items-center gap-2 rounded-md border border-slate-100 bg-brand-surface/55 px-4 py-2 text-sm tracking-tight text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
              </svg>
              创建知识库
            </a>
          </div>
        </section>
      </main>

      <AIAssistant isOpen={false} pageType="dashboard" />
      <AIToggleButton position="right" bottom="2rem" />
    </div>
  </body>
</html>

<script>
  import { deleteKnowledgeBase, listKnowledgeBases } from '../lib/api';
  import { recordAction, setPageContext } from '../lib/runtime-context';

  const state = {
    knowledgeBases: [],
    sort: 'recent',
  };

  const grid = document.getElementById('knowledge-base-grid');
  const emptyState = document.getElementById('knowledge-base-empty');
  const feedback = document.getElementById('dashboard-feedback');
  const sortSelect = document.getElementById('sort-select');
  const refreshButton = document.getElementById('refresh-knowledge-bases');
  const statKbCount = document.getElementById('stat-kb-count');
  const statDocCount = document.getElementById('stat-doc-count');
  const statProcessingCount = document.getElementById('stat-processing-count');
  const statReadyRate = document.getElementById('stat-ready-rate');

  function escapeHtml(text) {
    return String(text ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function setFeedback(message, tone = 'info') {
    if (!feedback) return;
    if (!message) {
      feedback.className = 'hidden mt-6 rounded-md border px-4 py-3 text-sm leading-7';
      feedback.textContent = '';
      return;
    }

    const toneClasses = {
      info: 'border-slate-100 bg-white text-slate-600',
      success: 'border-brand-blue/30 bg-brand-surface/35 text-slate-700',
      error: 'border-brand-sand/60 bg-brand-sand/35 text-slate-700',
    };

    feedback.className = `mt-6 rounded-md border px-4 py-3 text-sm leading-7 ${toneClasses[tone]}`;
    feedback.textContent = message;
  }

  function formatDateLabel(value) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '时间未知';
    return new Intl.DateTimeFormat('zh-CN', {
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    }).format(date);
  }

  function themeForKnowledgeBase(kb) {
    const themes = [
      { icon: '书', bar: 'bg-brand-blue', badge: 'bg-brand-surface/45' },
      { icon: '研', bar: 'bg-priority-important', badge: 'bg-brand-sand/45' },
      { icon: '理', bar: 'bg-[#b8c7b0]', badge: 'bg-[#eef3ea]' },
      { icon: '阅', bar: 'bg-[#c8b89a]', badge: 'bg-[#f5efe5]' },
    ];
    const seed = (kb.subject || kb.purpose || kb.id || '')
      .split('')
      .reduce((sum, ch) => sum + ch.charCodeAt(0), 0);
    return themes[seed % themes.length];
  }

  function sortKnowledgeBases(items) {
    const next = [...items];
    if (state.sort === 'documents') {
      return next.sort((a, b) => (b.documentCount || 0) - (a.documentCount || 0));
    }
    if (state.sort === 'progress') {
      return next.sort((a, b) => (b.progress || 0) - (a.progress || 0));
    }
    return next.sort(
      (a, b) => new Date(b.updatedAt || 0).getTime() - new Date(a.updatedAt || 0).getTime()
    );
  }

  function renderKnowledgeBaseCard(kb) {
    const theme = themeForKnowledgeBase(kb);
    const progress = Math.max(0, Math.min(Number(kb.progress) || 0, 100));
    const ready = Number(kb.readyDocumentCount) || 0;
    const processing = Number(kb.processingDocumentCount) || 0;
    const failed = Number(kb.failedDocumentCount) || 0;

    return `
      <article class="group h-full rounded-lg border border-slate-100 bg-white px-5 py-5 transition hover:border-brand-blue/40" data-kb-card="${escapeHtml(kb.id)}">
        <div class="flex items-start justify-between gap-4">
          <a href="/workspace/${encodeURIComponent(kb.id)}" class="flex min-w-0 flex-1 items-start gap-3">
            <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-slate-100 ${theme.badge} text-slate-500">
              <span class="text-sm font-medium tracking-tight">${theme.icon}</span>
            </div>
            <div class="min-w-0">
              <h3 class="truncate text-base font-medium tracking-tight text-slate-800">${escapeHtml(kb.name)}</h3>
              <p class="mt-1 line-clamp-2 text-sm leading-6 text-slate-500">${escapeHtml(kb.description || '暂无描述')}</p>
            </div>
          </a>
          <button
            class="delete-kb-btn inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-transparent text-slate-300 transition hover:border-slate-100 hover:bg-slate-50 hover:text-[#B98839]"
            data-delete-kb-id="${escapeHtml(kb.id)}"
            title="删除知识库"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 7.5h12M9.75 7.5v9m4.5-9v9M9 4.5h6l.75 1.5H8.25L9 4.5Z" />
            </svg>
          </button>
        </div>

        <div class="mt-5">
          <div class="h-px w-full overflow-hidden bg-slate-100">
            <div class="h-px ${theme.bar}" style="width: ${progress}%"></div>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between">
          <div class="space-y-1 text-[12px] tracking-tight text-slate-400">
            <p>${kb.documentCount || 0} 份文档 · 已就绪 ${ready}</p>
            <p>最近更新：${escapeHtml(formatDateLabel(kb.updatedAt))}</p>
          </div>
          <div class="text-right">
            <div class="text-sm font-medium tracking-tight text-slate-700">${progress}%</div>
            <div class="mt-1 text-[11px] tracking-tight text-slate-400">
              ${processing > 0 ? `解析中 ${processing}` : failed > 0 ? `失败 ${failed}` : '状态稳定'}
            </div>
          </div>
        </div>
      </article>
    `;
  }

  function updateStats(items) {
    const kbCount = items.length;
    const docCount = items.reduce((sum, item) => sum + (Number(item.documentCount) || 0), 0);
    const processingCount = items.reduce(
      (sum, item) => sum + (Number(item.processingDocumentCount) || 0),
      0
    );
    const readyCount = items.reduce(
      (sum, item) => sum + (Number(item.readyDocumentCount) || 0),
      0
    );
    const readyRate = docCount > 0 ? Math.round((readyCount / docCount) * 100) : 0;

    if (statKbCount) statKbCount.textContent = String(kbCount);
    if (statDocCount) statDocCount.textContent = String(docCount);
    if (statProcessingCount) statProcessingCount.textContent = String(processingCount);
    if (statReadyRate) statReadyRate.textContent = `${readyRate}%`;
  }

  function render() {
    if (!grid || !emptyState) return;
    const sorted = sortKnowledgeBases(state.knowledgeBases);
    updateStats(sorted);

    if (!sorted.length) {
      grid.innerHTML = '';
      emptyState.classList.remove('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    grid.innerHTML = sorted.map(renderKnowledgeBaseCard).join('');
  }

  async function loadKnowledgeBases({ silent = false } = {}) {
    try {
      const knowledgeBases = await listKnowledgeBases();
      state.knowledgeBases = knowledgeBases;
      render();
      recordAction('knowledge_bases_loaded', { knowledgeBaseCount: knowledgeBases.length });
      if (!silent) {
        setFeedback('知识库列表已刷新。', 'info');
      }
    } catch (error) {
      console.error('Failed to load knowledge bases:', error);
      setFeedback(error instanceof Error ? error.message : '知识库加载失败。', 'error');
    }
  }

  sortSelect?.addEventListener('change', (event) => {
    state.sort = event.target.value || 'recent';
    render();
  });

  refreshButton?.addEventListener('click', () => {
    void loadKnowledgeBases();
  });

  grid?.addEventListener('click', async (event) => {
    const target = event.target;
    const button = target?.closest?.('[data-delete-kb-id]');
    if (!button) return;

    event.preventDefault();
    event.stopPropagation();

    const kbId = button.getAttribute('data-delete-kb-id');
    const kb = state.knowledgeBases.find((item) => item.id === kbId);
    if (!kbId || !kb) return;

    const confirmed = window.confirm(`确认删除「${kb.name}」吗？相关文档记录也会一起移除。`);
    if (!confirmed) return;

    try {
      await deleteKnowledgeBase(kbId);
      state.knowledgeBases = state.knowledgeBases.filter((item) => item.id !== kbId);
      render();
      recordAction('knowledge_base_deleted', {
        knowledgeBaseId: kbId,
        knowledgeBaseName: kb.name,
      });
      setFeedback('知识库已删除。', 'success');
    } catch (error) {
      console.error('Failed to delete knowledge base:', error);
      setFeedback(error instanceof Error ? error.message : '删除知识库失败。', 'error');
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    setPageContext('dashboard');
    recordAction('dashboard_loaded');
    void loadKnowledgeBases({ silent: true });
  });
</script>
