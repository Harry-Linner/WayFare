---
import AIAssistant from '../components/ai/AIAssistant.astro';
import AIToggleButton from '../components/ai/AIToggleButton.astro';
import { knowledgeBases } from '../store/learningStore';
import '../styles/global.css';

const initialKnowledgeBases = knowledgeBases.get();

const learningStats = {
  totalStudyTime: '156 小时',
  totalDocuments: initialKnowledgeBases.reduce((sum, kb) => sum + kb.documentCount, 0),
  streakDays: 12,
  masteryRate: '68%'
};
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>知识库管理</title>
  </head>
  <body class="min-h-screen bg-brand-cream text-slate-700">
    <div class="min-h-screen">
      <nav class="border-b border-slate-100 bg-white/88 backdrop-blur-sm">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
          <div class="flex items-center gap-4">
            <a
              href="/dashboard"
              class="flex h-10 w-10 items-center justify-center rounded-md border border-slate-100 bg-brand-surface/40 text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface/70"
              title="仪表盘"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.75 12 3l8.25 6.75V20.25H3.75z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 20.25v-6h6v6" />
              </svg>
            </a>
            <div>
              <p class="text-[11px] uppercase tracking-[0.24em] text-slate-400">WayFare</p>
              <h1 class="mt-1 text-base font-medium tracking-tight text-slate-800">知识库管理</h1>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <a
              href="/create-knowledge-base"
              class="inline-flex items-center gap-2 rounded-md border border-slate-100 bg-brand-surface/55 px-4 py-2 text-sm tracking-tight text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
              </svg>
              <span>新建知识库</span>
            </a>
            <div class="flex h-9 w-9 items-center justify-center rounded-md border border-slate-100 bg-white text-[11px] font-medium uppercase tracking-[0.18em] text-slate-500">
              WF
            </div>
          </div>
        </div>
      </nav>

      <main class="mx-auto max-w-6xl px-6 py-10">
        <section class="border-b border-slate-100 pb-8">
          <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-2xl">
              <p class="text-[11px] uppercase tracking-[0.24em] text-slate-400">Library</p>
              <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-800">我的知识库</h2>
              <p class="mt-4 text-base leading-8 text-slate-500">
                把课程材料、论文和讲义整理成可持续阅读的结构。界面尽量保持安静，把注意力还给内容本身。
              </p>
            </div>

            <div id="stats-grid" class="grid grid-cols-2 gap-x-8 gap-y-5 lg:grid-cols-4">
              <div class="border-t border-slate-100 pt-4">
                <p class="text-[11px] uppercase tracking-[0.2em] text-slate-400">Study Time</p>
                <div class="mt-2 text-xl font-medium tracking-tight text-slate-800">{learningStats.totalStudyTime}</div>
              </div>
              <div class="border-t border-slate-100 pt-4">
                <p class="text-[11px] uppercase tracking-[0.2em] text-slate-400">Documents</p>
                <div id="total-documents-value" class="mt-2 text-xl font-medium tracking-tight text-slate-800">{learningStats.totalDocuments}</div>
              </div>
              <div class="border-t border-slate-100 pt-4">
                <p class="text-[11px] uppercase tracking-[0.2em] text-slate-400">Streak</p>
                <div class="mt-2 text-xl font-medium tracking-tight text-slate-800">{learningStats.streakDays} 天</div>
              </div>
              <div class="border-t border-slate-100 pt-4">
                <p class="text-[11px] uppercase tracking-[0.2em] text-slate-400">Mastery</p>
                <div class="mt-2 text-xl font-medium tracking-tight text-slate-800">{learningStats.masteryRate}</div>
              </div>
            </div>
          </div>
        </section>

        <section class="flex flex-col gap-4 border-b border-slate-100 py-6 md:flex-row md:items-center md:justify-between">
          <div class="flex items-center gap-3">
            <a
              href="/create-knowledge-base"
              class="inline-flex items-center gap-2 rounded-md border border-slate-100 bg-white px-4 py-2 text-sm tracking-tight text-slate-600 transition hover:border-slate-200 hover:bg-slate-50 hover:text-slate-700"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
              </svg>
              继续添加
            </a>
          </div>

          <div class="flex items-center gap-2">
            <select id="sort-select" class="rounded-md border border-slate-100 bg-white px-3 py-2 text-sm tracking-tight text-slate-500 focus:border-brand-blue/40 focus:outline-none">
              <option value="recent">最近访问</option>
              <option value="progress">学习进度</option>
              <option value="documents">文档数量</option>
            </select>
            <button class="rounded-md border border-slate-100 bg-white px-3 py-2 text-sm tracking-tight text-slate-500 transition hover:border-slate-200 hover:bg-slate-50 hover:text-slate-700">
              网格视图
            </button>
          </div>
        </section>

        <section class="pt-8">
          <div id="knowledge-base-grid" class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
            {initialKnowledgeBases.map((kb) => (
              <a href={`/workspace/${kb.id}`} class="kb-card group block" data-kb-id={kb.id}>
                <article class="h-full rounded-lg border border-slate-100 bg-white px-5 py-5 transition hover:border-brand-blue/40">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex min-w-0 items-start gap-3">
                      <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-slate-100 bg-brand-surface/35 text-slate-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 4.5h6l4.5 4.5V19.5H7.5z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5v4.5H18" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 13.5h6M9 16.5h4.5" />
                        </svg>
                      </div>
                      <div class="min-w-0">
                        <h3 class="truncate text-base font-medium tracking-tight text-slate-800">{kb.name}</h3>
                        <p class="mt-1 text-sm leading-6 text-slate-500 line-clamp-2">{kb.description}</p>
                      </div>
                    </div>

                    <div class="shrink-0 text-right">
                      <button
                        class="delete-kb-btn mb-2 inline-flex h-7 w-7 items-center justify-center rounded-md border border-transparent text-slate-300 transition hover:border-slate-100 hover:bg-slate-50 hover:text-[#B98839]"
                        data-delete-kb-id={kb.id}
                        title="删除知识库"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6 7.5h12M9.75 7.5v9m4.5-9v9M9 4.5h6l.75 1.5H8.25L9 4.5Z" />
                        </svg>
                      </button>
                      <div class="text-sm font-medium tracking-tight text-slate-700">{kb.progress}%</div>
                    </div>
                  </div>

                  <div class="mt-5">
                    <div class="h-px w-full overflow-hidden bg-slate-100">
                      <div
                        class={`h-px ${kb.color}`}
                        style={`width: ${kb.progress}%`}
                      ></div>
                    </div>
                  </div>

                  <div class="kb-card-meta mt-4 flex items-center justify-between opacity-0 transition duration-200 group-hover:opacity-100">
                    <div class="space-y-1 text-[12px] tracking-tight text-slate-400">
                      <p>{kb.documentCount} 份文档</p>
                      <p>最近访问 {kb.lastAccessed}</p>
                    </div>
                    <div class="flex items-center gap-2 text-slate-400">
                      <span class="rounded-md border border-slate-100 px-2 py-1 text-[11px] uppercase tracking-[0.18em]">
                        {kb.subject ?? 'general'}
                      </span>
                    </div>
                  </div>
                </article>
              </a>
            ))}
          </div>

          {initialKnowledgeBases.length === 0 && (
            <div id="knowledge-base-empty" class="py-20 text-center">
              <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-md border border-slate-100 bg-white text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 4.5h6l4.5 4.5V19.5H7.5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5v4.5H18" />
                </svg>
              </div>
              <h3 class="mt-5 text-lg font-medium tracking-tight text-slate-700">还没有知识库</h3>
              <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-slate-500">从一份教材、一门课程或一组研究笔记开始，建立属于你的长期学习档案。</p>
              <a
                href="/create-knowledge-base"
                class="mt-6 inline-flex items-center gap-2 rounded-md border border-slate-100 bg-brand-surface/55 px-4 py-2 text-sm tracking-tight text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
                </svg>
                创建知识库
              </a>
            </div>
          )}
        </section>
      </main>

      <AIAssistant isOpen={false} pageType="dashboard" />
      <AIToggleButton position="right" bottom="2rem" />
    </div>
  </body>
</html>

<script>
  import { knowledgeBases } from '../store/learningStore';

  function escapeHtml(text) {
    return String(text)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function renderKnowledgeBaseCard(kb) {
    const subject = kb.subject ?? 'general';
    return `
      <a href="/workspace/${escapeHtml(kb.id)}" class="kb-card group block" data-kb-id="${escapeHtml(kb.id)}">
        <article class="h-full rounded-lg border border-slate-100 bg-white px-5 py-5 transition hover:border-brand-blue/40">
          <div class="flex items-start justify-between gap-4">
            <div class="flex min-w-0 items-start gap-3">
              <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-slate-100 bg-brand-surface/35 text-slate-500">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 4.5h6l4.5 4.5V19.5H7.5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5v4.5H18" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 13.5h6M9 16.5h4.5" />
                </svg>
              </div>
              <div class="min-w-0">
                <h3 class="truncate text-base font-medium tracking-tight text-slate-800">${escapeHtml(kb.name)}</h3>
                <p class="mt-1 text-sm leading-6 text-slate-500 line-clamp-2">${escapeHtml(kb.description)}</p>
              </div>
            </div>
            <div class="shrink-0 text-right">
              <button
                class="delete-kb-btn mb-2 inline-flex h-7 w-7 items-center justify-center rounded-md border border-transparent text-slate-300 transition hover:border-slate-100 hover:bg-slate-50 hover:text-[#B98839]"
                data-delete-kb-id="${escapeHtml(kb.id)}"
                title="删除知识库"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 7.5h12M9.75 7.5v9m4.5-9v9M9 4.5h6l.75 1.5H8.25L9 4.5Z" />
                </svg>
              </button>
              <div class="text-sm font-medium tracking-tight text-slate-700">${kb.progress}%</div>
            </div>
          </div>

          <div class="mt-5">
            <div class="h-px w-full overflow-hidden bg-slate-100">
              <div class="h-px ${escapeHtml(kb.color)}" style="width: ${Number(kb.progress) || 0}%"></div>
            </div>
          </div>

          <div class="kb-card-meta mt-4 flex items-center justify-between opacity-0 transition duration-200 group-hover:opacity-100">
            <div class="space-y-1 text-[12px] tracking-tight text-slate-400">
              <p>${kb.documentCount} 份文档</p>
              <p>最近访问 ${escapeHtml(kb.lastAccessed)}</p>
            </div>
            <div class="flex items-center gap-2 text-slate-400">
              <span class="rounded-md border border-slate-100 px-2 py-1 text-[11px] uppercase tracking-[0.18em]">${escapeHtml(subject)}</span>
            </div>
          </div>
        </article>
      </a>
    `;
  }

  function ensureEmptyState() {
    let emptyState = document.getElementById('knowledge-base-empty');
    if (emptyState) return emptyState;

    const section = document.getElementById('knowledge-base-grid')?.parentElement;
    if (!section) return null;

    const html = `
      <div id="knowledge-base-empty" class="py-20 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-md border border-slate-100 bg-white text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 4.5h6l4.5 4.5V19.5H7.5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5v4.5H18" />
          </svg>
        </div>
        <h3 class="mt-5 text-lg font-medium tracking-tight text-slate-700">还没有知识库</h3>
        <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-slate-500">从一份教材、一门课程或一组研究笔记开始，建立属于你的长期学习档案。</p>
        <a href="/create-knowledge-base" class="mt-6 inline-flex items-center gap-2 rounded-md border border-slate-100 bg-brand-surface/55 px-4 py-2 text-sm tracking-tight text-slate-700 transition hover:border-brand-blue/40 hover:bg-brand-surface">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
          </svg>
          创建知识库
        </a>
      </div>
    `;

    section.insertAdjacentHTML('beforeend', html);
    return document.getElementById('knowledge-base-empty');
  }

  let currentSort = 'recent';

  function sortKnowledgeBases(kbs) {
    const items = [...kbs];
    if (currentSort === 'progress') {
      return items.sort((a, b) => (b.progress || 0) - (a.progress || 0));
    }
    if (currentSort === 'documents') {
      return items.sort((a, b) => (b.documentCount || 0) - (a.documentCount || 0));
    }
    return items.sort((a, b) => new Date(b.lastAccessed || 0).getTime() - new Date(a.lastAccessed || 0).getTime());
  }

  function updateUI(kbs) {
    const sortedKbs = sortKnowledgeBases(kbs);
    const totalDocsElement = document.getElementById('total-documents-value');
    if (totalDocsElement) {
      totalDocsElement.textContent = kbs.reduce((sum, kb) => sum + (kb.documentCount || 0), 0).toString();
    }

    const gridElement = document.getElementById('knowledge-base-grid');
    if (!gridElement) return;

    const emptyState = ensureEmptyState();

    if (!sortedKbs.length) {
      gridElement.innerHTML = '';
      emptyState?.classList.remove('hidden');
      return;
    }

    gridElement.innerHTML = sortedKbs.map(renderKnowledgeBaseCard).join('');
    emptyState?.classList.add('hidden');
    bindClickEvents();
    bindDeleteEvents();
  }

  function bindClickEvents() {
    document.querySelectorAll('[data-kb-id]').forEach((card) => {
      card.addEventListener('click', (e) => {
        e.preventDefault();
        const kbId = card.getAttribute('data-kb-id');
        if (!kbId) return;

        import('../store/learningStore').then(({ updateKnowledgeBaseAccess }) => {
          updateKnowledgeBaseAccess(kbId);
          window.location.href = `/workspace/${kbId}`;
        });
      });
    });
  }

  function bindDeleteEvents() {
    document.querySelectorAll('[data-delete-kb-id]').forEach((button) => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const kbId = button.getAttribute('data-delete-kb-id');
        if (!kbId) return;

        const target = knowledgeBases.get().find((kb) => kb.id === kbId);
        const name = target?.name || '该知识库';
        if (!window.confirm(`确认删除“${name}”吗？`)) return;

        import('../store/learningStore').then(({ deleteKnowledgeBase }) => {
          deleteKnowledgeBase(kbId);
          updateUI(knowledgeBases.get());
        });
      });
    });
  }

  const unsubscribe = knowledgeBases.subscribe((kbs) => {
    updateUI(kbs);
  });

  document.addEventListener('DOMContentLoaded', () => {
    const sortSelect = document.getElementById('sort-select');
    sortSelect?.addEventListener('change', (event) => {
      currentSort = event.target.value;
      updateUI(knowledgeBases.get());
    });

    updateUI(knowledgeBases.get());
    bindClickEvents();
    bindDeleteEvents();

    window.addEventListener('knowledgebase:added', () => {
      updateUI(knowledgeBases.get());
    });

    window.addEventListener('knowledgebase:deleted', () => {
      updateUI(knowledgeBases.get());
    });

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('refresh')) {
      setTimeout(() => {
        updateUI(knowledgeBases.get());
      }, 80);
    }
  });

  window.addEventListener('beforeunload', () => {
    unsubscribe?.();
  });
</script>
